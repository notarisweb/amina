---
// src/components/homepage/TrendingNews.astro
const { posts = [] } = Astro.props;

const formatTimeAgo = (dateStr) => {
  const postDate = new Date(dateStr);
  const now = new Date();
  const diffInSeconds = Math.floor((now.getTime() - postDate.getTime()) / 1000);
  if (diffInSeconds < 60) return "Baru saja";
  const diffInMinutes = Math.floor(diffInSeconds / 60);
  if (diffInMinutes < 60) return `${diffInMinutes} menit lalu`;
  const diffInHours = Math.floor(diffInMinutes / 60);
  if (diffInHours < 24) return `${diffInHours} jam lalu`;
  const diffInDays = Math.floor(diffInHours / 24);
  if (diffInDays < 7) return `${diffInDays} hari lalu`;
  return postDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
};
---

<section class="flex flex-col bg-white dark:bg-dark transition-colors duration-300">
  <div class="flex items-center gap-2 mb-4 border-b-2 border-gray-100 dark:border-white/10 pb-2">
    <span class="w-1 h-5 bg-orange-600"></span>
    <h3 class="font-black text-[12px] text-[#004d40] dark:text-teal-400 tracking-wider uppercase">
      Trending Sepekan
    </h3>
  </div>

  <div class="flex flex-col justify-start gap-1">
    {posts && posts.slice(0, 5).map((p, index) => (
      <a href={`/blog/${p.slug}`} class="group flex gap-3 items-center py-2 border-b border-gray-50 dark:border-white/5 last:border-0 transition-colors">
        
        <span class="text-2xl font-black text-gray-100 dark:text-white/5 group-hover:text-orange-200 transition-colors leading-none italic shrink-0">
          0{index + 1}
        </span>

        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-0.5">
            <span class="text-[9px] font-black text-orange-600 uppercase tracking-tighter">
              {p.data.categoryNames?.[0] || "Berita"}
            </span>
            <span class="text-[9px] font-bold text-gray-300 dark:text-gray-600 uppercase italic tracking-tighter">
              / {formatTimeAgo(p.data.date)}
            </span>
          </div>

          <h4 class="text-[13px] font-bold text-[#0b1c3c] dark:text-gray-100 leading-tight group-hover:text-orange-600 transition-all duration-300 line-clamp-2 tracking-tight">
            {p.data.title}
          </h4>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>