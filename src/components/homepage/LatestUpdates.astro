---
// Import komponen Image untuk optimasi byte & structure score
import { Image } from "astro:assets";

const { posts = [] } = Astro.props;

const formatTime = (dateStr) => {
  const postDate = new Date(dateStr);
  const now = new Date();
  const diffInSeconds = Math.floor((now.getTime() - postDate.getTime()) / 1000);
  if (diffInSeconds < 60) return "Baru saja";
  const diffInMinutes = Math.floor(diffInSeconds / 60);
  if (diffInMinutes < 60) return `${diffInMinutes} menit lalu`;
  const diffInHours = Math.floor(diffInMinutes / 60);
  if (diffInHours < 24) return `${diffInHours} jam lalu`;
  const diffInDays = Math.floor(diffInHours / 24);
  if (diffInDays < 7) return `${diffInDays} hari lalu`;
  return postDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
};
---

<section class="flex flex-col bg-white dark:bg-dark transition-colors duration-300">
  <div class="flex items-center gap-2 mb-4 border-l-4 border-[#004d40] dark:border-teal-500 pl-3">
    <h3 class="font-black text-[12px] text-[#004d40] dark:text-teal-400 uppercase tracking-wider">Latest Updates</h3>
  </div>

  <div class="flex flex-col justify-start gap-1">
    {posts.slice(0, 5).map((p) => (
      <a href={`/blog/${p.slug}`} class="group flex gap-3 items-center py-2 border-b border-gray-50 dark:border-white/5 last:border-0 transition-colors">
        
        <div class="w-16 h-11 shrink-0 bg-gray-100 dark:bg-white/5 overflow-hidden shadow-sm border border-transparent dark:border-white/5 relative">
          <Image 
            src={p.data.image} 
            width={120} 
            height={80}
            format="webp"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" 
            alt={p.data.title} 
          />
        </div>

        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-0.5">
             <span class="text-[9px] font-black text-orange-600 leading-none">{formatTime(p.data.date)}</span>
             <span class="text-[9px] font-bold text-gray-300 dark:text-gray-600 uppercase tracking-tighter">
               | {p.data.categoryNames?.[0] || "Update"}
             </span>
          </div>
          
          <h4 class="text-[13px] font-bold text-[#0b1c3c] dark:text-gray-100 leading-tight group-hover:text-orange-600 line-clamp-2 transition-colors tracking-tight">
            {p.data.title}
          </h4>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>