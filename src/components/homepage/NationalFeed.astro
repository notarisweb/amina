---
import { Image } from "astro:assets";
import { BiChevronRight } from "react-icons/bi";

const { posts = [] } = Astro.props;

const formatTime = (dateStr) => {
  const postDate = new Date(dateStr);
  const now = new Date();
  const diffInSeconds = Math.floor((now.getTime() - postDate.getTime()) / 1000);
  if (diffInSeconds < 60) return "Baru saja";
  const diffInMinutes = Math.floor(diffInSeconds / 60);
  if (diffInMinutes < 60) return `${diffInMinutes} mnt lalu`;
  const diffInHours = Math.floor(diffInMinutes / 60);
  if (diffInHours < 24) return `${diffInHours} jam lalu`;
  return postDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
};
---

<section class="bg-white dark:bg-dark transition-colors duration-300">
  <div class="flex justify-between items-end mb-10 border-b-2 border-gray-100 dark:border-white/10 pb-4">
    <div class="flex items-center gap-3">
      <span class="w-2 h-7 bg-orange-600"></span>
      <h2 class="text-2xl lg:text-3xl font-black text-slate-800 dark:text-white tracking-tighter uppercase">
        Berita Terkini
      </h2>
    </div>
  </div>

  <div class="flex flex-col gap-8">
    {posts && posts.length > 0 ? (
      posts.slice(0, 5).map((p) => (
        <a href={`/blog/${p.slug}`} class="group flex flex-col md:flex-row gap-6 lg:gap-8 items-start pb-8 border-b border-gray-50 dark:border-white/5 last:border-0 last:pb-0 transition-all">
          
          <div class="w-full md:w-52 lg:w-72 aspect-video shrink-0 overflow-hidden bg-gray-100 dark:bg-white/5 shadow-md border-none relative">
            <Image 
              src={p.data.image} 
              width={500} 
              height={281}
              format="webp"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
              alt={p.data.title || "Amina News"} 
            />
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-[10px] font-black text-orange-600 uppercase tracking-widest bg-orange-50 px-2 py-0.5 rounded-sm">
                {p.data.categoryNames?.[0] || "Update"}
              </span>
              <span class="text-[10px] font-bold text-gray-400 uppercase">
                {formatTime(p.data.date)}
              </span>
            </div>

            <h3 class="text-xl lg:text-2xl font-black leading-tight text-slate-800 dark:text-gray-100 group-hover:text-primary transition-colors mb-3 tracking-tighter">
              {p.data.title}
            </h3>

            <p class="text-sm text-gray-500 leading-relaxed line-clamp-2 font-medium">
              {p.data.excerpt}
            </p>
            
            <div class="mt-4 flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-slate-800 dark:text-white opacity-0 group-hover:opacity-100 transition-all transform group-hover:translate-x-1">
              Selengkapnya <span class="w-8 h-[1.5px] bg-orange-600"></span>
            </div>
          </div>
        </a>
      ))
    ) : (
       <p class="text-slate-400 italic text-sm py-10 text-center">Belum ada berita terbaru, Bos.</p>
    )}
  </div>

  <div class="mt-12 flex justify-end">
    <a 
      href="/blog" 
      class="inline-flex items-center justify-center bg-slate-900 hover:bg-orange-600 text-white py-3 px-10 text-[11px] font-black uppercase tracking-[0.2em] transition-all duration-300 shadow-xl hover:shadow-orange-200 dark:hover:shadow-none rounded-full group hover:-translate-y-1 active:scale-95"
    >
      Lihat Selengkapnya 
      <BiChevronRight className="ml-1 text-2xl group-hover:translate-x-1 transition-transform" />
    </a>
  </div>
</section>

<style is:global>
  /* JANGAN KASIH AMPUN UNTUK ELEMEN KONTEN */
  nav div, .aspect-video, img {
    border-radius: 0 !important;
  }
  
  /* TOMBOL KITA KECUALIKAN DARI RADIUS 0 AGAR ROUNDED-FULL JALAN */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>