---
// Import komponen Image untuk optimasi gambar otomatis (Grade A Booster)
import { Image } from "astro:assets";

const { posts = [] } = Astro.props;

// Fungsi penghitung waktu otomatis
const formatTime = (dateStr) => {
  const postDate = new Date(dateStr);
  const now = new Date();
  const diffInSeconds = Math.floor((now.getTime() - postDate.getTime()) / 1000);

  if (diffInSeconds < 60) return "Baru saja";
  const diffInMinutes = Math.floor(diffInSeconds / 60);
  if (diffInMinutes < 60) return `${diffInMinutes} menit lalu`;
  const diffInHours = Math.floor(diffInMinutes / 60);
  if (diffInHours < 24) return `${diffInHours} jam lalu`;
  const diffInDays = Math.floor(diffInHours / 24);
  if (diffInDays < 7) return `${diffInDays} hari lalu`;

  return postDate.toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  });
};
---

<section class="bg-white dark:bg-dark transition-colors duration-300">
  <div class="flex justify-between items-end mb-10 border-b-2 border-gray-100 dark:border-white/10 pb-4">
    <div class="flex items-center gap-3">
      <span class="w-2 h-7 bg-orange-600"></span>
      <h2 class="text-2xl lg:text-3xl font-black text-[#004d40] dark:text-teal-400 tracking-tighter uppercase">
        Berita Terkini
      </h2>
    </div>
    <a href="/categories/berita" class="text-[11px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500 hover:text-orange-600 transition-colors">
      Lihat Semua Berita <span class="text-[8px]">▶</span>
    </a>
  </div>

  <div class="flex flex-col gap-10">
    {posts && posts.length > 0 ? (
      posts.map((p) => (
        <a href={`/blog/${p.slug}`} class="group flex flex-col md:flex-row gap-6 lg:gap-8 items-start pb-10 border-b border-gray-50 dark:border-white/5 last:border-0 last:pb-0">
          
          <div class="w-full md:w-52 lg:w-72 aspect-[16/10] shrink-0 overflow-hidden bg-gray-100 dark:bg-white/5 shadow-sm border border-transparent dark:border-white/5 relative">
            <Image 
              src={p.data.image} 
              width={500} 
              height={312}
              format="webp"
              loading="lazy"
              decoding="async"
              alt={p.data.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-95 group-hover:opacity-100" 
            />
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-[10px] font-black text-orange-600 uppercase tracking-widest bg-orange-50 dark:bg-orange-950/30 px-2 py-0.5">
                {p.data.categoryNames?.[0] || "Berita"}
              </span>
              <span class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider">
                {formatTime(p.data.date)}
              </span>
            </div>

            <h3 class="text-xl lg:text-2xl font-black leading-tight text-[#0b1c3c] dark:text-gray-100 transition-all duration-300 group-hover:text-orange-600 group-hover:translate-x-1 mb-3 tracking-tighter">
              {p.data.title}
            </h3>

            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed line-clamp-2 font-medium">
              {p.data.excerpt}
            </p>
            
            <div class="mt-4 flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-[#004d40] dark:text-teal-400 opacity-0 group-hover:opacity-100 transition-all transform group-hover:translate-x-1">
              Baca Selengkapnya <span class="w-8 h-[1px] bg-[#004d40] dark:bg-teal-400"></span>
            </div>
          </div>
        </a>
      ))
    ) : (
      <div class="py-20 text-center border-2 border-dashed border-gray-100 dark:border-white/10">
        <p class="text-gray-400 text-sm italic">Opps! Belum ada berita terbaru untuk ditampilkan, Bos.</p>
      </div>
    )}
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>