---
// src/components/homepage/Sidebar.astro
import { Image } from "astro:assets";
import { BiTrendingUp, BiChevronRight, BiTimeFive } from "react-icons/bi";

const { popular = [] } = Astro.props;

// Berita pertama jadi Headline Sidebar, sisanya jadi list teks
const firstPost = popular[0];
const restPosts = popular.slice(1, 6);

// Fungsi waktu otomatis (Optimized)
const formatTimeAgo = (dateStr) => {
  const postDate = new Date(dateStr);
  const now = new Date();
  const diffInSeconds = Math.floor((now.getTime() - postDate.getTime()) / 1000);
  if (diffInSeconds < 60) return "Baru saja";
  const diffInMinutes = Math.floor(diffInSeconds / 60);
  if (diffInMinutes < 60) return `${diffInMinutes}m lalu`;
  const diffInHours = Math.floor(diffInMinutes / 60);
  if (diffInHours < 24) return `${diffInHours}j lalu`;
  const diffInDays = Math.floor(diffInHours / 24);
  if (diffInDays < 7) return `${diffInDays} hari lalu`;
  return postDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
};
---

<aside class="flex flex-col bg-white dark:bg-dark transition-colors duration-300">
  
  <div class="flex items-center justify-between mb-8 border-b-2 border-dark dark:border-white/10 pb-4">
    <div class="flex items-center gap-3">
      <div class="bg-orange-600 p-1 text-white">
        <BiTrendingUp className="text-xl" />
      </div>
      <h3 class="font-black text-sm md:text-base text-[#0b1c3c] dark:text-white tracking-[0.2em] uppercase">
        REKOMENDASI
      </h3>
    </div>
  </div>

  <div class="flex flex-col">
    {firstPost && (
      <a href={`/blog/${firstPost.slug}`} class="group block mb-8 border-b border-gray-100 dark:border-white/5 pb-8">
        <div class="aspect-video overflow-hidden mb-5 bg-gray-100 dark:bg-white/5 shadow-md relative">
          <img 
            src={firstPost.data.image} 
            alt={firstPost.data.title}
            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" 
          />
          <div class="absolute top-0 left-0 bg-orange-600 text-white text-[9px] font-black uppercase px-2 py-1 tracking-widest">
            HOT
          </div>
        </div>
        <h4 class="text-[20px] font-black text-[#0b1c3c] dark:text-white leading-tight group-hover:text-orange-600 transition-colors mb-3 tracking-tighter normal-case">
          {firstPost.data.title}
        </h4>
        <div class="flex items-center gap-2 text-[10px] text-gray-400 dark:text-gray-500 font-bold uppercase tracking-widest">
          <BiTimeFive className="text-orange-600" />
          {formatTimeAgo(firstPost.data.date)}
        </div>
      </a>
    )}

    <div class="flex flex-col gap-6">
      {restPosts.map((p) => (
        <a href={`/blog/${p.slug}`} class="group block border-b border-gray-50 dark:border-white/5 pb-6 last:border-0 last:pb-0">
          <h4 class="text-[15px] font-bold text-[#0b1c3c] dark:text-gray-200 leading-snug group-hover:text-orange-600 transition-all duration-300 mb-3 tracking-tight normal-case">
            {p.data.title}
          </h4>
          <div class="flex items-center gap-2 text-[9px] text-gray-400 dark:text-gray-600 font-bold uppercase tracking-[0.2em]">
            <span class="w-1.5 h-1.5 bg-primary/30 rotate-45 group-hover:bg-orange-600 transition-colors"></span>
            {formatTimeAgo(p.data.date)}
          </div>
        </a>
      ))}
    </div>
  </div>

  <a href="/categories/rekomendasi" class="mt-10 flex items-center justify-center border-2 border-[#0b1c3c] dark:border-white/10 py-3 text-[11px] font-black text-[#0b1c3c] dark:text-white uppercase tracking-[0.3em] hover:bg-[#0b1c3c] hover:text-white dark:hover:bg-white dark:hover:text-dark transition-all group">
    Lihat Semua <BiChevronRight className="text-xl transition-transform group-hover:translate-x-1" />
  </a>

</aside>

<style>
  /* Menghilangkan semua pembulatan (Border Radius) */
  aside * {
    border-radius: 0 !important;
  }

  h4 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>