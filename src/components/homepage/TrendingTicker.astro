---
// src/components/homepage/TrendingTicker.astro
const { posts = [] } = Astro.props;

// Kita ambil 10 berita terbaru untuk ditampilkan di running text
const tickerPosts = posts.slice(0, 10);
---

<div class="w-full bg-white dark:bg-[#0b1c3c] border-b border-gray-100 dark:border-white/5 h-11 lg:h-12 flex items-center overflow-hidden relative z-40 transition-colors duration-300">
  <div class="container flex items-center h-full relative">
    
    <div class="relative h-full flex items-center shrink-0 z-20 pr-8">
      <div class="bg-orange-600 text-white text-[10px] font-black uppercase tracking-[0.2em] px-5 h-full flex items-center relative shadow-[5px_0_15px_rgba(234,88,12,0.3)] slanted-badge">
        <span class="flex items-center gap-2 relative z-10">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
          </span>
          Terkini
        </span>
      </div>
    </div>

    <div class="flex-1 overflow-hidden h-full flex items-center relative group">
      <div class="absolute inset-y-0 left-0 w-12 bg-gradient-to-r from-white dark:from-[#0b1c3c] to-transparent z-10"></div>
      <div class="absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-white dark:from-[#0b1c3c] to-transparent z-10"></div>

      <div class="animate-marquee whitespace-nowrap flex items-center py-1">
        {tickerPosts.length > 0 ? tickerPosts.map((p) => (
          <a href={`/blog/${p.slug}`} class="text-[12px] font-bold text-dark/80 dark:text-gray-300 hover:text-primary dark:hover:text-primary transition-all mx-8 flex items-center gap-4">
            <span class="w-1.5 h-1.5 bg-orange-600 rotate-45"></span>
            {p.data.title}
          </a>
        )) : (
          <span class="text-[12px] text-gray-400 italic mx-8">Menghubungkan ke pusat informasi Amina Media...</span>
        )}
        
        {tickerPosts.map((p) => (
          <a href={`/blog/${p.slug}`} class="text-[12px] font-bold text-dark/80 dark:text-gray-300 hover:text-primary dark:hover:text-primary transition-all mx-8 flex items-center gap-4">
            <span class="w-1.5 h-1.5 bg-orange-600 rotate-45"></span>
            {p.data.title}
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  /* Efek Miring (Slanted) Badge Terkini */
  .slanted-badge::after {
    content: '';
    position: absolute;
    top: 0;
    right: -15px; /* Sesuaikan derajat miring */
    width: 30px;
    height: 100%;
    background: inherit;
    transform: skewX(-20deg); /* KUNCI: Biar gak segi empat kaku */
    z-index: 1;
  }

  /* Animasi Marquee Pure CSS */
  .animate-marquee {
    display: inline-flex;
    animation: marquee 45s linear infinite; /* Kecepatan pas, tidak bikin pusing */
    width: max-content;
  }

  .group:hover .animate-marquee {
    animation-play-state: paused; /* Berhenti saat di-hover user */
  }

  @keyframes marquee {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }

  /* Optimasi Performa & Anti Blur saat gerak */
  .animate-marquee a {
    backface-visibility: hidden;
    transform: translateZ(0);
  }
</style>