---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import { AstroFont } from "astro-font";
import { ClientRouter } from "astro:transitions";

const pf = theme.fonts.font_family.primary;
let fontPrimary;
if (pf) {
  fontPrimary = pf
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;]+/gi, "");
}

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  structuredData?: object; 
  articleDate?: string;
  articleAuthor?: string;
}

const { 
  title, 
  meta_title, 
  description, 
  image, 
  noindex, 
  canonical, 
  structuredData,
  articleDate,
  articleAuthor
} = Astro.props;

// 1. LOGIKA SEO & URL
const siteTitle = config.site.title;
const siteUrl = config.site.base_url || "https://amina.or.id";
const finalTitle = plainify(
  meta_title || (title ? `${title} | ${siteTitle}` : siteTitle)
);
const finalDescription = plainify(
  description || config.metadata.meta_description
);

const currentUrl = Astro.url.href;
const finalCanonical = canonical || currentUrl.replace('studio.', '');

// 2. FIX GAMBAR WHATSAPP: Pastikan URL Selalu Absolut
let finalImage = "";
if (image) {
  finalImage = image.startsWith("http") ? image : `${siteUrl}${image}`;
} else {
  finalImage = `${siteUrl}${config.metadata.meta_image}`;
}

const GA_ID = "G-XDX1TKCDP1";
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="generator" content={Astro.generator} />

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA_ID);
      document.addEventListener('astro:after-swap', () => {
        gtag('config', GA_ID, { page_path: window.location.pathname });
      });
    </script>

    <AstroFont
      config={[
        {
          src: [],
          preload: true,
          display: "swap",
          name: fontPrimary!,
          fallback: "sans-serif",
          cssVariable: "font-primary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${pf}&display=swap`,
        },
      ]}
    />

    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <link rel="canonical" href={finalCanonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={finalCanonical} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={finalImage} />
    <meta property="og:image:secure_url" content={finalImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {articleDate && <meta property="article:published_time" content={articleDate} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={finalImage} />

    <link rel="shortcut icon" href={config.site.favicon} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData || {})} />

    <ClientRouter />

    <style is:global>
      /* PROGRESS BAR FIX - TINGKAT DEWA */
      #progress-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 5px;
        z-index: 999999;
        background: rgba(255, 255, 255, 0.1);
        pointer-events: none;
      }
      #progress-bar {
        height: 100%;
        width: 0%;
        background: #2563eb;
        box-shadow: 0 0 15px rgba(37, 99, 235, 1);
        transition: width 0.2s ease-out;
      }

      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: #f8fafc; }
      ::-webkit-scrollbar-thumb { background: #0b1c3c; border-radius: 10px; }
    </style>
  </head>

  <body class="antialiased">
    <div id="progress-container">
      <div id="progress-bar"></div>
    </div>

    {config.google_tag_manager.enable && <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />}

    <TwSizeIndicator />
    <Header />
    
    <main id="main-content" class="min-h-[70vh]" transition:animate="fade">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      const setupProgress = () => {
        const bar = document.getElementById('progress-bar');
        if (!bar) return;

        const update = () => {
          const scroll = window.scrollY || document.documentElement.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const pct = (scroll / height) * 100;
          bar.style.width = pct + "%";
        };

        window.addEventListener('scroll', update);
        update(); 
      };

      setupProgress();
      document.addEventListener('astro:page-load', setupProgress);
    </script>
  </body>
</html>