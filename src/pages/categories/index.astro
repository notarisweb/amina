---
import Base from "@/layouts/Base.astro";
import { humanize } from "@/lib/utils/textConverter";
import { BiCategoryAlt, BiHash } from "react-icons/bi";
// FIX: Import ini yang tadi ketinggalan, Bos!
import TrendingTicker from "@/components/homepage/TrendingTicker.astro";

// 1. SSR AKTIF
export const prerender = false;

// 2. Lingkungan API (REST VERSION - Lebih Stabil)
const API_BASE = "https://studio.amina.or.id/wp-json/wp/v2";

let categories = [];
let tickerPosts = [];

try {
  // Ambil Kategori & Postingan Terbaru secara pararel
  const [resCat, resPosts] = await Promise.all([
    fetch(`${API_BASE}/categories?per_page=100&hide_empty=true`),
    fetch(`${API_BASE}/posts?per_page=10`)
  ]);

  const dataCat = await resCat.json();
  const dataPosts = await resPosts.json();

  categories = Array.isArray(dataCat) ? dataCat : [];
  
  // Mapping untuk Ticker
  tickerPosts = Array.isArray(dataPosts) ? dataPosts.map((p: any) => ({
    slug: p.slug,
    data: { title: p.title.rendered }
  })) : [];

} catch (e) {
  console.error("Gagal konek ke WordPress:", e);
}

const title = "Kategori Artikel";
---

<Base title={`${title} | Amina Media`}>
  
  <TrendingTicker posts={tickerPosts} />

  <section class="bg-[#0b1c3c] py-16 md:py-24 text-white w-full border-t border-white/5 relative overflow-hidden">
    <div class="container relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-primary/20 text-primary px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest mb-6 border border-primary/20">
          <BiHash className="text-sm" /> Khazanah Keilmuan
        </div>
        <h1 class="text-4xl md:text-6xl font-black mb-6 tracking-tighter uppercase leading-[1.1]">
          {title}
        </h1>
        <p class="text-white/50 text-base md:text-lg max-w-xl font-medium leading-relaxed">
          Temukan hikmah dan informasi islami yang memudahkan proses belajar Anda.
        </p>
      </div>
    </div>
  </header>

  <main class="py-20 bg-white dark:bg-dark transition-colors duration-300 min-h-[50vh]">
    <div class="container">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {categories.length > 0 ? (
          categories.map((category) => (
            <a
              href={`/categories/${category.slug}`}
              class="group relative bg-gray-50 dark:bg-[#06142e] p-8 rounded-3xl border border-gray-100 dark:border-white/5 hover:border-primary/50 transition-all duration-500 hover:shadow-2xl"
            >
              <div class="relative z-10 flex flex-col h-full">
                <div class="flex justify-between items-start mb-6">
                  <div class="w-12 h-12 rounded-2xl bg-white dark:bg-dark flex items-center justify-center shadow-sm group-hover:bg-primary transition-colors duration-500">
                    <BiCategoryAlt className="text-primary group-hover:text-white h-6 w-6 transition-colors" />
                  </div>
                  <span class="text-[11px] font-black bg-white dark:bg-dark px-3 py-1.5 rounded-full text-dark/40 dark:text-gray-500 border border-gray-100 dark:border-white/5 group-hover:bg-orange-600 group-hover:text-white transition-all">
                    {category.count} Artikel
                  </span>
                </div>
                
                <h2 class="text-xl md:text-2xl font-black text-[#0b1c3c] dark:text-white group-hover:text-primary transition-colors tracking-tight uppercase">
                  {humanize(category.name)}
                </h2>
                
                <div class="mt-8 flex items-center gap-2 text-[10px] font-black text-primary uppercase tracking-[0.2em] opacity-0 group-hover:opacity-100 transition-all transform translate-y-2 group-hover:translate-x-1">
                  Lihat Artikel <span class="w-6 h-[1px] bg-primary"></span>
                </div>
              </div>
            </a>
          ))
        ) : (
          <div class="col-span-full py-20 text-center border-2 border-dashed border-gray-100 dark:border-white/5 rounded-3xl">
            <p class="text-gray-400 italic">Maaf Bos, data kategori gagal dimuat atau sedang kosong.</p>
          </div>
        )}
      </div>

    </div>
  </main>
</Base>

<style is:global>
  /* Menghancurkan padding kaku dari class .section bawaan tema */
  .section {
    padding: 0 !important;
  }
</style>