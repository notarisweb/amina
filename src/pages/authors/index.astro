---
import Authors from "@/components/Authors.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
// FIX: Import ini yang tadi hilang/lupa dimasukin
import TrendingTicker from "@/components/homepage/TrendingTicker.astro";

export const prerender = false;

const API_BASE = "https://studio.amina.or.id/wp-json/wp/v2";

let authors = [];
let tickerPosts = [];
let totalPages = 1;

try {
  // Ambil data Penulis & Postingan (untuk Ticker) secara pararel
  const [resUsers, resPosts] = await Promise.all([
    fetch(`${API_BASE}/users?per_page=100`),
    fetch(`${API_BASE}/posts?per_page=10`)
  ]);

  const wpAuthors = await resUsers.json();
  const wpPosts = await resPosts.json();

  // Mapping Penulis
  authors = Array.isArray(wpAuthors) ? wpAuthors.map((user: any) => ({
    id: user.slug,
    slug: user.slug,
    body: user.description || "",
    data: {
      title: user.name || "Penulis",
      image: user.avatar_urls?.["96"] || "/images/author-placeholder.png",
      description: user.description || "Kontributor resmi Amina Media",
      social: [],
    }
  })) : [];

  // Mapping Ticker
  tickerPosts = Array.isArray(wpPosts) ? wpPosts.map((p: any) => ({
    slug: p.slug,
    data: { title: p.title.rendered }
  })) : [];

  totalPages = Math.ceil(authors.length / config.settings.pagination);
} catch (e) {
  console.error("Gagal mengambil data penulis:", e);
}

const currentAuthors = authors.slice(0, config.settings.pagination);
---

<Base title={"Daftar Penulis | Amina Media"}>
  
  <TrendingTicker posts={tickerPosts} />

  <main class="py-16 bg-white dark:bg-dark transition-colors duration-300 min-h-[70vh]">
    <div class="container">
      
      <div class="mb-16 border-b-2 border-gray-100 dark:border-white/10 pb-8">
        <div class="inline-block bg-orange-600 text-white text-[10px] font-black px-3 py-1 uppercase mb-4 tracking-widest">
          The Team
        </div>
        <h1 class="text-4xl md:text-5xl font-black text-[#004d40] dark:text-teal-400 tracking-tighter uppercase mb-4">
          Para Penulis
        </h1>
        <p class="text-gray-500 dark:text-gray-400 max-w-2xl font-medium leading-relaxed">
          Mengenal sosok di balik layar yang mendedikasikan ilmunya untuk syiar Islam di <span class="text-primary font-bold">amina.or.id</span>.
        </p>
      </div>

      <div class="min-h-[40vh]">
        {currentAuthors.length > 0 ? (
          <>
            <Authors authors={currentAuthors} />
            
            {totalPages > 1 && (
              <div class="mt-20 py-10 border-t border-gray-50 dark:border-white/5 flex justify-center">
                <Pagination section={"authors"} currentPage={1} totalPages={totalPages} />
              </div>
            )}
          </>
        ) : (
          <div class="py-20 text-center bg-gray-50 dark:bg-white/5 rounded-3xl border-2 border-dashed border-gray-100 dark:border-white/10">
            <p class="text-xl font-bold text-[#0b1c3c] dark:text-white mb-2">Belum ada penulis ditemukan.</p>
          </div>
        )}
      </div>

    </div>
  </main>
</Base>

<style is:global>
  /* Menghancurkan padding kaku yang bikin offside */
  .section {
    padding: 0 !important;
  }
</style>