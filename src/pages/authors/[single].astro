---
import Base from "@/layouts/Base.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { Image } from "astro:assets";
import { humanize, slugify } from "@/lib/utils/textConverter";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";
import AuthorSingle from "@/layouts/partials/AuthorSingle.astro";

export const prerender = true;

export async function getStaticPaths() {
  const WP_URL = import.meta.env.PUBLIC_WP_URL;
  
  // 1. Ambil semua penulis
  const authorQuery = {
    query: `query { users(first: 100) { nodes { name slug description avatar { url } } } }`,
  };

  try {
    const authorRes = await fetch(WP_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(authorQuery),
    });
    const authorData = await authorRes.json();
    
    // FILTER: Hanya penulis yang punya SLUG yang diproses
    const allAuthors = (authorData.data?.users?.nodes || []).filter((a: any) => a.slug);

    // 2. Ambil artikel untuk setiap penulis
    const paths = await Promise.all(
      allAuthors.map(async (author: any) => {
        const postQuery = {
          query: `
            query GetPostsByAuthor($authorName: String!) {
              posts(where: {authorName: $authorName}, first: 12) {
                nodes {
                  title
                  slug
                  date
                  categories { nodes { name } }
                  featuredImage { node { sourceUrl } }
                }
              }
            }
          `,
          variables: { authorName: author.name },
        };

        const postRes = await fetch(WP_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(postQuery),
        });
        
        const postData = await postRes.json();
        const wpPosts = postData.data?.posts?.nodes || [];

        const formattedPosts = wpPosts.filter((p: any) => p.slug).map((post: any) => ({
          id: post.slug,
          slug: post.slug,
          data: {
            title: post.title || "Judul Artikel",
            date: post.date,
            image: post.featuredImage?.node?.sourceUrl || "/images/placeholder.png",
            categories: post.categories?.nodes.map((c: any) => c.name) || [],
          },
        }));

        return {
          params: { single: author.slug },
          props: { 
            author: {
              id: author.slug,
              slug: author.slug,
              body: author.description || "",
              data: {
                title: author.name || "Penulis",
                description: author.description || "Penulis di Amina Media",
                image: author.avatar?.url || "/images/author-placeholder.png",
                meta_title: author.name,
              }
            },
            posts: formattedPosts
          },
        };
      })
    );

    return paths;
  } catch (e) {
    console.error("Gagal build paths penulis:", e);
    return [];
  }
}

const { author, posts } = Astro.props;

// PENGAMAN: Jika author tidak ada, jangan render sisa kodenya (Mencegah Error 'data' of undefined)
if (!author) {
  return Astro.redirect('/404');
}

const { title, meta_title, description, image } = author.data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <AuthorSingle author={author} />
  
  {posts && posts.length > 0 && (
    <section class="section pt-0">
      <div class="container">
        <h2 class="mb-12 text-center font-black uppercase tracking-tighter text-3xl md:text-4xl text-[#0b1c3c]">
           <span class="text-primary block text-xs tracking-[0.3em] mb-2">KARYA TERBARU</span>
           Artikel Oleh {title}
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post: any) => (
            <div class="group bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-500">
              {post.data.image && (
                <a href={`/blog/${post.slug}`} class="block overflow-hidden aspect-video bg-gray-100">
                  <Image
                    class="group-hover:scale-110 transition duration-700 w-full h-full object-cover"
                    src={post.data.image}
                    alt={post.data.title} 
                    width={600}
                    height={337}
                    format="webp"
                  />
                </a>
              )}
              
              <div class="p-6">
                <div class="flex items-center gap-4 text-[10px] font-black uppercase tracking-widest text-dark/30 mb-4">
                   <span class="flex items-center gap-1.5"><BiCalendarEdit className="h-3.5 w-3.5 text-primary" /> {dateFormat(post.data.date)}</span>
                   {post.data.categories.length > 0 && (
                     <span class="flex items-center gap-1.5"><BiCategoryAlt className="h-3.5 w-3.5 text-primary" /> {post.data.categories[0]}</span>
                   )}
                </div>

                <h3 class="text-lg font-black text-[#0b1c3c] group-hover:text-primary transition leading-tight uppercase tracking-tight mb-4 line-clamp-2">
                  <a href={`/blog/${post.slug}`} set:html={post.data.title} />
                </h3>
                
                <a href={`/blog/${post.slug}`} class="text-[10px] font-black text-primary uppercase tracking-[0.2em] inline-flex items-center group/btn">
                  Baca Artikel <span class="ml-2 transition-transform group-hover/btn:translate-x-1">→</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .aspect-video {
    aspect-ratio: 16 / 9;
  }
</style>