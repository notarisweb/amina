---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import TrendingTicker from "@/components/homepage/TrendingTicker.astro";
import AuthorSingle from "@/layouts/partials/AuthorSingle.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { Image } from "astro:assets";

export const prerender = true;

export async function getStaticPaths({ paginate }) {
  const WP_URL = import.meta.env.PUBLIC_WP_URL;
  if (!WP_URL) {
    console.error("Waduh Bos, PUBLIC_WP_URL belum disetel di environment variable Cloudflare!");
    return [];
  }
  
  try {
    // 1. Ambil semua data penulis
    const authorQuery = {
      query: `query { users(first: 100) { nodes { name slug description avatar { url } } } }`,
    };

    const authorRes = await fetch(WP_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(authorQuery),
    });

    // PENGAMAN KRUSIAL 1: Validasi format respons data penulis
    const contentType = authorRes.headers.get("content-type");
    if (!authorRes.ok || !contentType || !contentType.includes("application/json")) {
      const errorText = await authorRes.text();
      console.error("🚨 AMANKAN BUILD: WordPress melempar non-JSON saat mengambil data Users/Authors!");
      console.error(`Status HTTP: ${authorRes.status}`);
      console.error("Potongan teks balasannya:", errorText.slice(0, 300));
      return []; // Return kosong agar build tidak mogok
    }

    const authorData = await authorRes.json();
    
    if (authorData.errors) {
      console.error("GraphQL Error pada query users:", authorData.errors);
      return [];
    }

    const allAuthors = (authorData.data?.users?.nodes || []).filter((a: any) => a && a.slug);

    // 2. Loop setiap penulis untuk ambil artikel mereka
    const allPaths = await Promise.all(
      allAuthors.map(async (author: any) => {
        try {
          const postQuery = {
            query: `
              query GetPostsByAuthor($authorName: String!) {
                posts(where: {authorName: $authorName}, first: 100) {
                  nodes {
                    title
                    slug
                    date
                    categories { nodes { name } }
                    featuredImage { node { sourceUrl } }
                  }
                }
              }
            `,
            variables: { authorName: author.name },
          };

          const postRes = await fetch(WP_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(postQuery),
          });
          
          // PENGAMAN KRUSIAL 2: Validasi respons artikel penulis individual
          const innerContentType = postRes.headers.get("content-type");
          if (!postRes.ok || !innerContentType || !innerContentType.includes("application/json")) {
            console.error(`🚨 Request artikel untuk penulis [${author.name}] diblokir/gagal.`);
            
            // Buat fallback dummy agar struktur paginate tidak hancur di tengah jalan
            return paginate([{ dummy: true }], {
              params: { single: author.slug },
              props: { 
                author: {
                  id: author.slug,
                  slug: author.slug,
                  data: {
                    title: author.name,
                    description: author.description || "Penulis di Amina Media",
                    image: author.avatar?.url || "/images/author-placeholder.png",
                    meta_title: author.name,
                  }
                } 
              },
              pageSize: 9,
            });
          }

          const postData = await postRes.json();
          const wpPosts = postData.data?.posts?.nodes || [];

          // Mapping artikel penulis dengan optional chaining
          const formattedPosts = wpPosts
            .filter((post: any) => post && post.slug)
            .map((post: any) => ({
              slug: post.slug,
              data: {
                title: post.title || "Judul Tidak Tersedia",
                date: post.date || new Date().toISOString(),
                image: post.featuredImage?.node?.sourceUrl || "/images/placeholder.png",
                categories: post.categories?.nodes?.map((c: any) => c?.name).filter(Boolean) || [],
              },
            }));

          // Data profil penulis untuk dikirim ke props
          const authorInfo = {
            id: author.slug,
            slug: author.slug,
            data: {
              title: author.name,
              description: author.description || "Penulis di Amina Media",
              image: author.avatar?.url || "/images/author-placeholder.png",
              meta_title: author.name,
            }
          };

          return paginate(formattedPosts.length > 0 ? formattedPosts : [{ dummy: true }], {
            params: { single: author.slug },
            props: { author: authorInfo },
            pageSize: 9,
          });

        } catch (innerError) {
          console.error(`Gagal memproses data penulis [${author.name}]:`, innerError);
          // Return data pancingan kosong agar rilis global tidak crash berkeping-keping
          return paginate([{ dummy: true }], {
            params: { single: author.slug },
            props: { 
              author: {
                id: author.slug,
                slug: author.slug,
                data: { title: author.name, description: "Penulis di Amina Media", image: "/images/author-placeholder.png", meta_title: author.name }
              } 
            },
            pageSize: 9,
          });
        }
      })
    );

    return allPaths.flat().filter(Boolean);

  } catch (globalError) {
    console.error("Fatal Error pada fungsi getStaticPaths() authors:", globalError);
    return [];
  }
}

const { page, author } = Astro.props;
// Amankan jika page atau page.data bernilai undefined sewaktu-waktu
const posts = page?.data ? page.data.filter(p => p && !p.dummy) : [];
---

<Base title={`${author?.data?.title || 'Penulis'} - Halaman ${page?.currentPage || 1}`}>
  <TrendingTicker posts={[]} />

  <main class="py-16 bg-[#f8fafc] dark:bg-dark min-h-screen">
    <div class="container max-w-6xl mx-auto px-6">
      
      {author && <AuthorSingle author={author} />}

      <div class="mt-20">
        <div class="mb-12 border-l-[12px] border-orange-600 pl-8">
          <h2 class="text-3xl font-black uppercase tracking-tighter text-slate-800 dark:text-white">
            Karya {author?.data?.title || 'Penulis'}
          </h2>
        </div>

        {posts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
            {posts.map((post: any) => (
              <div class="bg-white dark:bg-white/5 rounded-[2rem] overflow-hidden shadow-xl border border-slate-100 dark:border-white/5 group">
                <a href={`/blog/${post.slug}`} class="block aspect-video overflow-hidden">
                  <img src={post.data.image} class="w-full h-full object-cover group-hover:scale-110 transition duration-700" alt={post.data.title} />
                </a>
                <div class="p-8">
                  <h3 class="font-black text-lg text-slate-800 dark:text-white uppercase line-clamp-2 mb-4">
                    <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                  </h3>
                  <p class="text-[10px] font-black text-orange-600 uppercase tracking-widest">{dateFormat(post.data.date)}</p>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-center py-20 text-slate-400 font-bold uppercase">Belum ada artikel.</p>
        )}

        {page && page.lastPage > 1 && (
          <div class="mt-20 flex justify-center border-t border-slate-100 dark:border-white/5 pt-10">
            <Pagination 
              section={`authors/${author.slug}`} 
              currentPage={page.currentPage} 
              totalPages={page.lastPage} 
            />
          </div>
        )}
      </div>
    </div>
  </main>
</Base>