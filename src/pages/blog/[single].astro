---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { slugify } from "@/lib/utils/textConverter";
import { 
  BiCalendarEdit, BiUserCircle, BiChevronRight, BiShareAlt, 
  BiTimeFive, BiListUl, BiShow, BiCopy, BiCheck, 
  BiHeart, BiRightArrowAlt
} from "react-icons/bi";
import { FaFacebookF, FaWhatsapp, FaTelegramPlane } from "react-icons/fa";

export const prerender = true;

function escapeRegExp(string) {
  return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

export async function getStaticPaths() {
  const WP_URL = import.meta.env.PUBLIC_WP_URL;
  const query = {
    query: `
      query GetStaticBuildData {
        posts(first: 1000) { 
          nodes {
            slug
            title
            content
            date
            excerpt
            author { node { name } }
            categories { nodes { name slug } }
            featuredImage { node { sourceUrl } }
          }
        }
        categories(first: 30) { 
          nodes { name slug count }
        }
      }
    `,
  };

  try {
    const response = await fetch(WP_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(query),
    });
    const result = await response.json();
    const rawPosts = result.data?.posts?.nodes || [];
    const allPosts = rawPosts.filter((p: any) => p.slug && p.slug.trim() !== "");
    const sidebarCategories = result.data?.categories?.nodes?.filter((c: any) => c.count > 0) || [];

    return allPosts.map((post: any) => ({
      params: { single: post.slug },
      props: { post, allPosts, sidebarCategories },
    }));
  } catch (e) {
    console.error("Gagal build paths:", e);
    return [];
  }
}

const { post, allPosts, sidebarCategories } = Astro.props;
const currentUrl = Astro.url;
const donationUrl = "https://bdp.amina.or.id/#donasi"; 

const primaryCategory = post.categories?.nodes?.[0]?.name || "Internasional";
const popularPosts = allPosts.filter(p => p.slug !== post.slug).slice(0, 8);

// --- TOC LOGIC ---
const headings = post.content.match(/<h[2-3][^>]*>.*?<\/h[2-3]>/g) || [];
const toc = headings.map((h) => {
  const text = h.replace(/<[^>]*>/g, '').trim();
  const id = slugify(text);
  const depth = h.includes('h2') ? 2 : 3;
  return { text, id, depth };
});

let contentWithIds = post.content;
toc.forEach((item) => {
  const headingTag = item.depth === 2 ? 'h2' : 'h3';
  const searchPattern = new RegExp(`<${headingTag}[^>]*>${escapeRegExp(item.text)}<\/${headingTag}>`, 'g');
  contentWithIds = contentWithIds.replace(searchPattern, `<${headingTag} id="${item.id}">${item.text}</${headingTag}>`);
});

const shareLinks = [
  { name: 'Facebook', icon: FaFacebookF, color: '#1877F2', url: `https://www.facebook.com/sharer/sharer.php?u=${currentUrl}` },
  { name: 'WhatsApp', icon: FaWhatsapp, color: '#25D366', url: `https://api.whatsapp.com/send?text=${post.title} ${currentUrl}` },
  { name: 'Telegram', icon: FaTelegramPlane, color: '#0088cc', url: `https://t.me/share/url?url=${currentUrl}&text=${post.title}` },
];
---

<Base 
  title={post.title} 
  description={post.excerpt} 
  image={post.featuredImage?.node?.sourceUrl}
  articleDate={post.date}
  articleAuthor={post.author?.node?.name}
>
  <div class="bg-white dark:bg-dark border-b border-gray-100 dark:border-white/5 py-4">
    <div class="container">
      <nav class="flex items-center space-x-2 text-[10px] font-bold uppercase tracking-widest text-gray-400">
        <a href="/" class="hover:text-primary transition">Home</a>
        <BiChevronRight className="opacity-40" />
        <a href={`/categories/${post.categories?.nodes?.[0]?.slug}`} class="text-primary">{primaryCategory}</a>
      </nav>
    </div>
  </div>

  <main class="py-12 bg-white dark:bg-dark transition-colors duration-300">
    <div class="container">
      <div class="flex flex-wrap lg:flex-nowrap gap-16">
        
        <div class="w-full lg:w-[65%]">
          <header class="mb-10">
            <h1 set:html={post.title} class="text-4xl md:text-5xl lg:text-6xl font-black leading-[1.15] mb-8 text-[#0b1c3c] dark:text-white tracking-tight" />
            
            <div class="flex flex-col gap-4 border-l-4 border-primary pl-6 py-2 mb-8">
               <span class="text-sm font-bold text-dark/80 dark:text-gray-300 italic">Oleh: {post.author?.node?.name}</span>
               <span class="text-xs font-bold text-gray-400 uppercase tracking-widest">{dateFormat(post.date)}</span>
            </div>

            <div class="flex items-center gap-3 py-6 border-y border-gray-100 dark:border-white/5">
               <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest mr-4">Bagikan:</span>
               {shareLinks.map((item) => (
                  <a href={item.url} target="_blank" class="w-10 h-10 flex items-center justify-center text-white transition rounded-full shadow-md hover:scale-110" style={{ backgroundColor: item.color }} title={item.name}><item.icon className="h-4 w-4" /></a>
               ))}
               <button id="copy-link-btn" class="w-10 h-10 flex items-center justify-center bg-gray-100 dark:bg-white/10 text-dark dark:text-white transition shadow-sm rounded-full hover:bg-primary hover:text-white">
                  <BiCopy id="icon-copy" className="h-4 w-4" />
                  <BiCheck id="icon-check" className="h-4 w-4 hidden" />
               </button>
            </div>
          </header>

          {post.featuredImage?.node?.sourceUrl && (
            <figure class="mb-12">
              <div class="overflow-hidden bg-gray-100 dark:bg-white/5 border border-gray-100 dark:border-white/5 shadow-xl">
                <Image src={post.featuredImage.node.sourceUrl} width={1200} height={675} format="webp" loading="eager" class="w-full h-auto object-cover" alt={post.title} />
              </div>
            </figure>
          )}

          {toc.length > 0 && (
            <div class="mb-12 bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/10 p-8 shadow-sm">
              <h2 class="text-[11px] font-black mb-6 text-dark/50 dark:text-white/40 flex items-center tracking-[0.3em] uppercase">
                <BiListUl className="mr-3 h-5 w-5 text-primary" /> DAFTAR ISI
              </h2>
              <nav class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-4">
                {toc.map((item) => (
                  <a href={`#${item.id}`} class={`text-[13px] transition hover:text-primary leading-tight flex items-start gap-2 ${item.depth === 3 ? 'ml-6 opacity-60' : 'font-black'}`}>
                    <span class="text-primary mt-1">▹</span> {item.text}
                  </a>
                ))}
              </nav>
            </div>
          )}

          <article class="content prose prose-lg md:prose-xl max-w-none text-dark/90 dark:text-white/80 leading-[1.9] mb-20" set:html={contentWithIds} />

          <div class="bg-gradient-to-br from-[#0b1c3c] to-[#004d40] p-8 md:p-12 rounded-2xl shadow-2xl relative overflow-hidden mb-24 text-white">
            <div class="relative z-10 flex flex-col md:flex-row items-center gap-10">
               <div class="flex-1 text-center md:text-left">
                  <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/10 rounded-full mb-6 border border-white/10">
                     <BiHeart className="text-orange-400 h-4 w-4 animate-pulse" />
                     <span class="text-[10px] font-bold uppercase tracking-widest">Wasilah Jariyah</span>
                  </div>
                  <h2 class="text-2xl md:text-3xl font-black mb-4 leading-tight tracking-tighter uppercase text-teal-400">
                    Dukungan Anda Adalah <br/> Energi Dakwah Kami
                  </h2>
                  <p class="text-white/70 text-sm md:text-base font-medium leading-relaxed italic">
                    Mari menjadi bagian dari mata rantai kebaikan yang tak terputus. Setiap kontribusi Anda sangat berarti bagi keberlanjutan syiar Islam dan kemanusiaan.
                  </p>
               </div>
               <div class="shrink-0 w-full md:w-auto">
                  <a href={donationUrl} target="_blank" class="w-full bg-orange-600 hover:bg-orange-700 text-white font-black uppercase tracking-widest py-3 px-8 rounded-xl text-[12px] flex items-center justify-center transition-all shadow-xl hover:scale-105 group">
                    Kontribusi Sekarang <BiRightArrowAlt className="ml-2 h-5 w-5 group-hover:translate-x-1.5 transition" />
                  </a>
               </div>
            </div>
          </div>
        </div>

        <aside class="w-full lg:w-[32%]">
          <div class="sticky top-28 space-y-20">
            
            <div class="prayer-widget rounded-xl p-8 text-white relative overflow-hidden shadow-2xl bg-[#008800]">
               <div class="absolute inset-0 opacity-10" style="background-image: url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cpath d=\"M30 0l2.5 12.5L45 15l-12.5 2.5L30 30l-2.5-12.5L15 15l12.5-2.5z\" fill=\"%23ffffff\" fill-opacity=\"1\" fill-rule=\"evenodd\"/%3E%3C/svg%3E');"></div>
               
               <div class="relative z-10 flex flex-col items-center text-center">
                  <span class="text-xl font-medium mb-4">Waktu Shalat</span>
                  <div class="text-6xl font-normal tracking-tight mb-4 drop-shadow-md" id="real-time-clock">00:00:00</div>
                  
                  <div class="inline-flex items-center gap-2 border border-white/40 px-4 py-1.5 rounded-lg text-sm font-medium mb-10 bg-black/10">
                    Jakarta <span class="text-[10px]">▼</span>
                  </div>
                  
                  <div class="grid grid-cols-5 gap-1 w-full text-[11px]">
                     <div class="flex flex-col gap-2"><span>Subuh</span><span id="sholat-subuh">04:41</span></div>
                     <div class="flex flex-col gap-2"><span>Zhuhur</span><span id="sholat-dzuhur">12:02</span></div>
                     <div class="flex flex-col gap-2"><span>Ashar</span><span id="sholat-ashar">15:12</span></div>
                     <div class="flex flex-col gap-2"><span>Maghrib</span><span id="sholat-maghrib">18:05</span></div>
                     <div class="flex flex-col gap-2"><span>Isya'</span><span id="sholat-isya">19:14</span></div>
                  </div>
               </div>
            </div>

            <div>
              <h2 class="text-xs font-black text-dark dark:text-white mb-10 flex items-center uppercase tracking-[0.4em] border-l-4 border-orange-600 pl-4">BERITA TERBARU</h2>
              <ul class="divide-y divide-gray-100 dark:divide-white/5">
                {popularPosts.map((p: any) => (
                  <li class="py-6 first:pt-0 group">
                    <a href={`/blog/${p.slug}`} class="flex gap-5 items-start">
                      <div class="w-24 h-16 shrink-0 overflow-hidden bg-gray-50 border border-gray-100 dark:border-white/5 shadow-sm">
                        <img src={p.featuredImage?.node?.sourceUrl || "/images/placeholder.png"} class="w-full h-full object-cover group-hover:scale-110 transition duration-500" alt={p.title} />
                      </div>
                      <div class="flex-1">
                        <h3 class="text-[13px] font-black text-dark dark:text-white group-hover:text-primary transition leading-snug line-clamp-2 tracking-tight">{p.title}</h3>
                        <div class="flex items-center gap-3 mt-2 text-[9px] font-bold text-gray-400 uppercase tracking-widest">
                           <span class="text-primary">{p.categories?.nodes?.[0]?.name || "UPDATE"}</span>
                           <span>{dateFormat(p.date)}</span>
                        </div>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </main>
</Base>

<script is:inline>
  async function fetchPrayTimes() {
    const now = new Date();
    try {
      const res = await fetch(`https://api.myquran.com/v2/sholat/jadwal/1402/${now.getFullYear()}/${String(now.getMonth() + 1).padStart(2, '0')}/${String(now.getDate()).padStart(2, '0')}`);
      const json = await res.json();
      const j = json.data.jadwal;
      document.getElementById('sholat-subuh').innerText = j.subuh;
      document.getElementById('sholat-dzuhur').innerText = j.dzuhur;
      document.getElementById('sholat-ashar').innerText = j.ashar;
      document.getElementById('sholat-maghrib').innerText = j.maghrib;
      document.getElementById('sholat-isya').innerText = j.isya;
    } catch (e) {}
  }

  function updateClock() {
    const now = new Date();
    const clock = document.getElementById('real-time-clock');
    if (clock) clock.innerText = now.toLocaleTimeString('id-ID', { hour12: false });
  }

  setInterval(updateClock, 1000);
  updateClock();
  fetchPrayTimes();

  document.getElementById('copy-link-btn')?.addEventListener('click', function() {
    const iconCopy = document.getElementById('icon-copy');
    const iconCheck = document.getElementById('icon-check');
    navigator.clipboard.writeText(window.location.href).then(() => {
      iconCopy.classList.add('hidden');
      iconCheck.classList.remove('hidden');
      setTimeout(() => {
        iconCopy.classList.remove('hidden');
        iconCheck.classList.add('hidden');
      }, 2500);
    });
  });

  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) window.scrollTo({ top: target.offsetTop - 120, behavior: 'smooth' });
    });
  });
</script>

<style is:global>
  .section { padding: 0 !important; }
  .content p { @apply mb-8 text-lg md:text-xl leading-[1.9] text-dark/80 dark:text-white/70 font-sans; }
  .content h2 { @apply text-2xl md:text-3xl font-black uppercase mt-16 mb-8 text-[#0b1c3c] dark:text-teal-400 tracking-tight leading-tight border-b-4 border-primary w-max pb-2; }
  .content h3 { @apply text-xl md:text-2xl font-black uppercase mt-12 mb-6 text-dark dark:text-white tracking-tight; }
  .content blockquote { @apply border-l-8 border-primary pl-8 py-4 italic text-2xl font-black text-[#0b1c3c] dark:text-white my-14 bg-gray-50 dark:bg-white/5 rounded-none pr-6; }
  .content img { @apply rounded-none my-12 shadow-2xl mx-auto h-auto border-4 border-white dark:border-white/5; }
  .content a { @apply text-primary font-bold underline decoration-2 underline-offset-4 hover:text-orange-600 transition; }
</style>