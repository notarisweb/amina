---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { slugify } from "@/lib/utils/textConverter";
import { BiCalendarEdit, BiUserCircle, BiChevronRight, BiShareAlt, BiTimeFive, BiListUl, BiShow } from "react-icons/bi";
import { FaFacebookF, FaWhatsapp, FaTelegramPlane } from "react-icons/fa";

export const prerender = true;

// HELPER: Menghindari error RegExp pada judul dengan karakter spesial
function escapeRegExp(string) {
  return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

export async function getStaticPaths() {
  const WP_URL = import.meta.env.PUBLIC_WP_URL;
  const query = {
    query: `
      query GetStaticBuildData {
        posts(first: 100) {
          nodes {
            slug
            title
            content
            date
            excerpt
            author { node { name } }
            categories { nodes { name slug } }
            featuredImage { node { sourceUrl } }
          }
        }
        categories(first: 30) { 
          nodes { name slug count }
        }
      }
    `,
  };

  try {
    const response = await fetch(WP_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(query),
    });
    const result = await response.json();
    const allPosts = result.data?.posts?.nodes || [];
    const sidebarCategories = result.data?.categories?.nodes?.filter((c: any) => c.count > 0) || [];

    return allPosts.map((post: any) => ({
      params: { single: post.slug },
      props: { post, allPosts, sidebarCategories },
    }));
  } catch (e) {
    console.error("Gagal ambil data build:", e);
    return [];
  }
}

const { post, allPosts, sidebarCategories } = Astro.props;
const currentUrl = Astro.url;
const siteUrl = "https://amina.or.id"; 

// --- LOGIKA TABLE OF CONTENTS ---
const headings = post.content.match(/<h[2-3][^>]*>.*?<\/h[2-3]>/g) || [];
const toc = headings.map((h) => {
  const text = h.replace(/<[^>]*>/g, '').trim();
  const id = slugify(text);
  const depth = h.includes('h2') ? 2 : 3;
  return { text, id, depth };
});

let contentWithIds = post.content;
toc.forEach((item) => {
  const headingTag = item.depth === 2 ? 'h2' : 'h3';
  const searchPattern = new RegExp(`<${headingTag}[^>]*>${escapeRegExp(item.text)}<\/${headingTag}>`, 'g');
  contentWithIds = contentWithIds.replace(searchPattern, `<${headingTag} id="${item.id}">${item.text}</${headingTag}>`);
});

const wordsPerMinute = 200;
const textLength = post.content.split(' ').length;
const readingTime = Math.ceil(textLength / wordsPerMinute);
const primaryCategory = post.categories?.nodes[0]?.name || "Berita";
const popularPosts = allPosts.slice(0, 5);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Beranda", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": primaryCategory, "item": `${siteUrl}/categories/${slugify(primaryCategory)}` },
    { "@type": "ListItem", "position": 3, "name": post.title, "item": currentUrl.href }
  ]
};

const shareLinks = [
  { name: 'Facebook', icon: FaFacebookF, color: '#1877F2', url: `https://www.facebook.com/sharer/sharer.php?u=${currentUrl}` },
  { name: 'WhatsApp', icon: FaWhatsapp, color: '#25D366', url: `https://api.whatsapp.com/send?text=${post.title} ${currentUrl}` },
  { name: 'Telegram', icon: FaTelegramPlane, color: '#0088cc', url: `https://t.me/share/url?url=${currentUrl}&text=${post.title}` },
];
---

<Base 
  title={post.title} 
  description={post.excerpt} 
  image={post.featuredImage?.node?.sourceUrl}
  structuredData={breadcrumbSchema}
  articleDate={post.date}
  articleAuthor={post.author?.node?.name}
>
  <section class="bg-[#0b1c3c] py-4 md:py-8 text-white w-full border-t border-white/5 relative overflow-hidden">
    <div class="container relative z-10">
      <nav class="flex items-center space-x-2 text-[10px] mb-2 text-white/40 font-bold uppercase tracking-[0.2em]">
        <a href="/" class="hover:text-primary transition uppercase">Home</a>
        <BiChevronRight className="opacity-20" />
        <a href={`/categories/${post.categories?.nodes[0]?.slug}`} class="hover:text-primary transition uppercase font-black">{primaryCategory}</a>
      </nav>
      <h1 set:html={post.title} class="text-2xl md:text-4xl lg:text-5xl text-white font-black leading-[1.2] mb-4 max-w-5xl tracking-tighter uppercase" />
      <div class="flex flex-wrap items-center gap-6 text-[10px] font-bold text-white/30 uppercase tracking-widest border-t border-white/5 pt-4">
        <span class="flex items-center"><BiUserCircle className="mr-1.5 h-4 w-4 text-primary" /> {post.author?.node?.name}</span>
        <span class="flex items-center"><BiCalendarEdit className="mr-1.5 h-4 w-4 text-primary" /> {dateFormat(post.date)}</span>
        <span class="flex items-center bg-white/5 px-2.5 py-1 rounded-full"><BiTimeFive className="mr-1.5 h-3.5 w-3.5 text-primary" /> {readingTime} MIN BACA</span>
      </div>
    </div>
  </section>

  <section class="py-10 bg-[#fcfcfc]">
    <div class="container">
      <div class="flex flex-wrap lg:flex-nowrap gap-10">
        <article class="w-full lg:w-[68%]">
          {post.featuredImage?.node?.sourceUrl && (
            <div class="mb-8 overflow-hidden rounded-xl shadow-2xl aspect-video relative group bg-gray-100">
              <Image src={post.featuredImage.node.sourceUrl} width={1200} height={675} format="webp" loading="eager" fetchpriority="high" class="absolute inset-0 w-full h-full object-cover" alt={post.title || "Gambar Artikel"} />
            </div>
          )}

          <div class="flex items-center gap-3 mb-8 pb-4 border-b border-gray-100">
             <span class="text-[10px] font-bold text-dark/40 uppercase tracking-widest mr-2 flex items-center"><BiShareAlt className="mr-1 h-3 w-3" /> BAGIKAN:</span>
             {shareLinks.map((item) => (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="w-8 h-8 flex items-center justify-center rounded-lg text-white transition hover:scale-110 shadow-sm" style={{ backgroundColor: item.color }}><item.icon className="h-3 w-3" /></a>
             ))}
          </div>

          <div class="content prose prose-lg md:prose-xl max-w-none text-dark/80 leading-[1.7] first-letter:text-5xl first-letter:font-black first-letter:text-primary first-letter:mr-2 first-letter:float-left" set:html={post.content} />
        </article>

        <aside class="w-full lg:w-[32%]">
          <div class="sticky top-24 space-y-10">
            
            {toc.length > 0 && (
              <div class="bg-white p-10 rounded-[2rem] shadow-[0_20px_60px_rgba(0,0,0,0.04)] border border-gray-50">
                <h2 class="text-[11px] font-black mb-8 text-dark flex items-center tracking-[0.25em] uppercase">
                  <BiListUl className="mr-3 h-5 w-5 text-primary" /> DAFTAR ISI
                </h2>
                <nav class="space-y-4">
                  {toc.map((item) => (
                    <a href={`#${item.id}`} class={`block text-[13px] transition hover:text-primary leading-relaxed ${item.depth === 3 ? 'ml-6 text-dark/40 font-medium' : 'text-dark/60 font-bold'}`}>
                      {item.text}
                    </a>
                  ))}
                </nav>
              </div>
            )}
            
            <div class="bg-white p-8 md:p-10 rounded-[2rem] shadow-[0_20px_60px_rgba(0,0,0,0.03)] border border-gray-50">
              <h2 class="text-lg font-black text-[#0b1c3c] flex items-center mb-10 uppercase tracking-tight">
                <span class="w-1.5 h-7 bg-primary mr-4 rounded-full"></span>
                Terpopuler
              </h2>
              
              <ul class="space-y-10">
                {popularPosts.map((p: any, index: number) => (
                  <li class="group relative flex gap-6">
                    <span class="text-4xl md:text-5xl font-black italic text-dark/5 group-hover:text-primary/10 transition duration-500 select-none shrink-0 italic leading-none">
                      {(index + 1).toString().padStart(2, '0')}
                    </span>
                    
                    <div class="flex-1">
                      <a href={`/blog/${p.slug}`} class="block group">
                        <h3 class="text-[14px] md:text-[15px] font-black text-dark/80 group-hover:text-primary transition duration-300 leading-snug mb-3 uppercase tracking-tight line-clamp-2">
                          {p.title}
                        </h3>
                      </a>
                      
                      <div class="flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-primary">
                         <span>{p.categories?.nodes[0]?.name || "BERITA"}</span>
                         <span class="text-dark/10">•</span>
                         <span class="flex items-center gap-1 text-dark/30">
                           <BiTimeFive className="h-3 w-3" /> 
                           {dateFormat(p.date)}
                         </span>
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>