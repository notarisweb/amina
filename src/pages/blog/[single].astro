---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { slugify } from "@/lib/utils/textConverter";
import { 
  BiChevronRight, BiListUl, BiCopy, BiCheck, 
  BiHeart, BiRightArrowAlt, BiTimeFive, BiUserCircle
} from "react-icons/bi";
import { FaFacebookF, FaWhatsapp, FaTelegramPlane } from "react-icons/fa";

export const prerender = true;

function escapeRegExp(string) {
  return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

export async function getStaticPaths() {
  const WP_URL = import.meta.env.PUBLIC_WP_URL;
  const query = {
    query: `
      query GetStaticBuildData {
        posts(first: 1000) { 
          nodes {
            slug title content date excerpt
            author { node { name } }
            categories { nodes { name slug } }
            featuredImage { node { sourceUrl } }
          }
        }
        categories(first: 30) { nodes { name slug count } }
      }
    `,
  };
  try {
    const response = await fetch(WP_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(query),
    });
    const result = await response.json();
    const rawPosts = result.data?.posts?.nodes || [];
    const allPosts = rawPosts.filter((p: any) => p.slug && p.slug.trim() !== "");
    const sidebarCategories = result.data?.categories?.nodes?.filter((c: any) => c.count > 0) || [];
    return allPosts.map((post: any) => ({
      params: { single: post.slug },
      props: { post, allPosts, sidebarCategories },
    }));
  } catch (e) { return []; }
}

const { post, allPosts, sidebarCategories } = Astro.props;
const currentUrl = Astro.url;
const donationUrl = "https://bdp.amina.or.id/#donasi"; 

const primaryCategory = post.categories?.nodes?.[0]?.name || "Berita";
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug && p.categories?.nodes.some(cat => cat.name === primaryCategory))
  .slice(0, 3);

const popularPosts = allPosts.filter(p => p.slug !== post.slug).slice(0, 8);

// TOC LOGIC
const headings = post.content.match(/<h[2-3][^>]*>.*?<\/h[2-3]>/g) || [];
const toc = headings.map((h) => {
  const text = h.replace(/<[^>]*>/g, '').trim();
  const id = slugify(text);
  return { text, id, depth: h.includes('h2') ? 2 : 3 };
});

let contentWithIds = post.content;
toc.forEach((item) => {
  const headingTag = item.depth === 2 ? 'h2' : 'h3';
  const searchPattern = new RegExp(`<${headingTag}[^>]*>${escapeRegExp(item.text)}<\/${headingTag}>`, 'g');
  contentWithIds = contentWithIds.replace(searchPattern, `<${headingTag} id="${item.id}">${item.text}</${headingTag}>`);
});

const shareLinks = [
  { name: 'Facebook', icon: FaFacebookF, color: '#1877F2', url: `https://www.facebook.com/sharer/sharer.php?u=${currentUrl}` },
  { name: 'WhatsApp', icon: FaWhatsapp, color: '#25D336', url: `https://api.whatsapp.com/send?text=${post.title} ${currentUrl}` },
  { name: 'Telegram', icon: FaTelegramPlane, color: '#0088cc', url: `https://t.me/share/url?url=${currentUrl}&text=${post.title}` },
];

// Time Formatting
const postTime = new Date(post.date).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + " WIB";

// SEO Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": Astro.site },
    { "@type": "ListItem", "position": 2, "name": primaryCategory, "item": `${Astro.site}categories/${post.categories?.nodes?.[0]?.slug}` },
    { "@type": "ListItem", "position": 3, "name": post.title, "item": currentUrl }
  ]
};
---

<Base title={post.title} description={post.excerpt} image={post.featuredImage?.node?.sourceUrl} articleDate={post.date} articleAuthor={post.author?.node?.name}>
  
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="py-6 bg-white dark:bg-dark">
    <div class="container">
      <nav class="flex items-center text-[11px] font-bold uppercase tracking-wider">
        <a href="/" class="text-primary hover:underline">Home</a>
        <BiChevronRight className="mx-2 text-gray-300 h-4 w-4" />
        <a href={`/categories/${post.categories?.nodes?.[0]?.slug}`} class="text-primary hover:underline">{primaryCategory}</a>
        <BiChevronRight className="mx-2 text-gray-300 h-4 w-4 hidden md:inline" />
        <span class="text-gray-400 truncate max-w-[200px] hidden md:inline font-medium tracking-normal normal-case italic">{post.title}</span>
      </nav>
    </div>
  </div>

  <main class="pb-20 bg-white dark:bg-dark">
    <div class="container">
      <div class="flex flex-wrap lg:flex-nowrap gap-16">
        
        <div class="w-full lg:w-[65%]">
          <header class="mb-10">
            <h1 set:html={post.title} class="text-4xl md:text-6xl font-black leading-[1.1] mb-10 text-[#0b1c3c] dark:text-white tracking-tighter" />
            
            <div class="flex flex-wrap items-center justify-between gap-6 py-6 border-y border-gray-100 dark:border-white/5 mb-12">
               <div class="flex items-center gap-3">
                  <div class="text-primary text-5xl opacity-80"><BiUserCircle /></div>
                  <div class="flex flex-col">
                     <span class="text-[12px] font-black text-[#0b1c3c] dark:text-gray-300 uppercase tracking-widest leading-none mb-1.5">{post.author?.node?.name}</span>
                     <span class="text-[10px] font-bold text-gray-400 uppercase tracking-[0.1em]">{dateFormat(post.date)} • {postTime}</span>
                  </div>
               </div>
               <div class="flex items-center gap-2.5">
                  {shareLinks.map((item) => (
                     <a href={item.url} target="_blank" class="w-9 h-9 flex items-center justify-center text-white transition rounded-full hover:scale-110 shadow-sm" style={{ backgroundColor: item.color }}><item.icon className="h-4 w-4" /></a>
                  ))}
                  <button id="copy-link-btn" class="w-9 h-9 flex items-center justify-center bg-gray-50 dark:bg-white/10 text-dark/40 transition rounded-full hover:bg-primary hover:text-white">
                     <BiCopy id="icon-copy" className="h-4 w-4" /><BiCheck id="icon-check" className="h-4 w-4 hidden" />
                  </button>
               </div>
            </div>
          </header>

          {post.featuredImage?.node?.sourceUrl && (
            <figure class="mb-12">
              <div class="aspect-video overflow-hidden bg-gray-50 border border-gray-100 dark:border-white/5 shadow-2xl">
                <Image 
                  src={post.featuredImage.node.sourceUrl} 
                  width={1280} 
                  height={720} 
                  format="webp" 
                  loading="eager" 
                  class="w-full h-full object-cover" 
                  alt={post.title || "Headline Image"} 
                />
              </div>
            </figure>
          )}

          <article class="content prose prose-lg md:prose-xl max-w-none !w-full text-dark/90 dark:text-white/80 text-left" set:html={contentWithIds} />

          <div class="bg-gradient-to-br from-orange-400 via-orange-500 to-orange-600 p-8 md:p-12 rounded-[2.5rem] shadow-2xl relative overflow-hidden my-16 text-white">
            <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-10">
               <div class="flex-1 text-center md:text-left">
                  <div class="inline-flex items-center gap-2 mb-4 bg-white/20 px-4 py-1.5 rounded-full"><BiHeart className="text-white h-4 w-4 animate-pulse" /><span class="text-[10px] font-black uppercase tracking-[0.3em]">Solidaritas Ummat</span></div>
                  <h2 class="text-3xl md:text-4xl font-black mb-4 leading-tight uppercase tracking-tighter border-none text-white italic">Wasilah Jariyah</h2>
                  <p class="text-white text-sm md:text-base font-bold opacity-90 leading-relaxed">Dukungan Anda menggerakkan misi dakwah Amina Media.</p>
               </div>
               <div class="shrink-0"><a href={donationUrl} target="_blank" class="inline-flex items-center bg-white text-orange-600 font-black uppercase tracking-widest py-4 px-10 rounded-xl text-[12px] transition-all hover:scale-105 group">Donasi Sekarang <BiRightArrowAlt className="ml-2 h-6 w-6 group-hover:translate-x-2 transition" /></a></div>
            </div>
          </div>

          {relatedPosts.length > 0 && (
            <div class="mb-20 pt-10 border-t border-gray-100 dark:border-white/5">
              <h2 class="text-[11px] font-black text-primary mb-10 flex items-center uppercase tracking-[0.4em]">ARTIKEL TERKAIT</h2>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
                {relatedPosts.map((rp) => (
                  <a href={`/blog/${rp.slug}`} class="group flex flex-col h-full">
                    <div class="aspect-video overflow-hidden bg-gray-50 mb-4 shadow-md border border-gray-100 dark:border-white/5">
                      <Image 
                        src={rp.featuredImage?.node?.sourceUrl || "/images/placeholder.png"} 
                        width={400} 
                        height={225} 
                        class="w-full h-full object-cover group-hover:scale-110 transition duration-700" 
                        alt={rp.title || "Related Post"} 
                      />
                    </div>
                    <h3 class="text-[14px] font-black leading-snug text-[#0b1c3c] dark:text-white group-hover:text-primary transition line-clamp-3">{rp.title}</h3>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        <aside class="w-full lg:w-[32%]">
          <div class="sticky top-28 space-y-16">
            <div class="prayer-widget p-8 text-white relative overflow-hidden shadow-2xl bg-[#008800] rounded-2xl border-b-8 border-green-900 text-center">
               <div class="absolute inset-0 opacity-10" style="background-image: url('data:image/svg+xml,%3Csvg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cpath d=\"M20 0l2 8 8 2-8 2-2 8-2-8-8-2 8-2z\" fill=\"%23ffffff\" fill-opacity=\"1\" fill-rule=\"evenodd\"/%3E%3C/svg%3E');"></div>
               <span class="text-[11px] font-black uppercase tracking-[0.4em] mb-2 opacity-60">WAKTU SHALAT</span>
               <div class="text-6xl font-black tracking-tighter mb-4" id="real-time-clock">--:--</div>
               <div class="inline-flex items-center gap-2 border-2 border-white/20 px-6 py-1.5 rounded-full text-[10px] font-black mb-8 bg-black/10 tracking-widest uppercase">Banyumas ▼</div>
               <div class="grid grid-cols-5 gap-2 w-full text-[10px] font-black">
                  <div class="flex flex-col gap-2"><span>SUB</span><span id="sholat-subuh">--:--</span></div>
                  <div class="flex flex-col gap-2"><span>ZHU</span><span id="sholat-dzuhur">--:--</span></div>
                  <div class="flex flex-col gap-2"><span>ASH</span><span id="sholat-ashar">--:--</span></div>
                  <div class="flex flex-col gap-2"><span>MAG</span><span id="sholat-maghrib">--:--</span></div>
                  <div class="flex flex-col gap-2"><span>ISY</span><span id="sholat-isya">--:--</span></div>
               </div>
            </div>

            <div>
              <h2 class="text-xs font-black text-dark dark:text-white mb-8 flex items-center uppercase tracking-[0.5em] border-l-4 border-orange-600 pl-4">BERITA TERBARU</h2>
              <ul class="divide-y divide-gray-100 dark:divide-white/5">
                {popularPosts.map((p: any) => (
                  <li class="py-6 first:pt-0 group border-none">
                    <a href={`/blog/${p.slug}`} class="flex gap-4 items-start">
                      <div class="w-24 h-16 shrink-0 overflow-hidden bg-gray-50 border border-gray-100 shadow-md">
                        <img src={p.featuredImage?.node?.sourceUrl || "/images/placeholder.png"} class="w-full h-full object-cover group-hover:scale-110 transition duration-500" alt={p.title || "Latest Post"} />
                      </div>
                      <div class="flex-1">
                        <h3 class="text-[18px] font-black text-[#0b1c3c] dark:text-white group-hover:text-primary transition leading-tight line-clamp-2">{p.title}</h3>
                        <span class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mt-2 block">{dateFormat(p.date)}</span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>
</Base>

<script is:inline>
  async function fetchPrayTimes() {
    const now = new Date();
    const year = now.getFullYear();
    const month = String(now.getMonth() + 1).padStart(2, '0');
    const day = String(now.getDate()).padStart(2, '0');
    try {
      const res = await fetch(`https://api.myquran.com/v2/sholat/jadwal/1402/${year}/${month}/${day}`);
      const json = await res.json();
      if (json.status && json.data) {
        const j = json.data.jadwal;
        const ids = ['subuh', 'dzuhur', 'ashar', 'maghrib', 'isya'];
        ids.forEach(id => { document.getElementById(`sholat-${id}`).textContent = j[id]; });
      }
    } catch (e) {}
  }
  function updateClock() {
    const clock = document.getElementById('real-time-clock');
    if (clock) clock.textContent = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', hour12: false });
  }
  setInterval(updateClock, 1000);
  updateClock();
  fetchPrayTimes();
  document.getElementById('copy-link-btn')?.addEventListener('click', function() { 
    navigator.clipboard.writeText(window.location.href); 
    const iconCopy = document.getElementById('icon-copy');
    const iconCheck = document.getElementById('icon-check');
    iconCopy.classList.add('hidden'); iconCheck.classList.remove('hidden');
    setTimeout(() => { iconCopy.classList.remove('hidden'); iconCheck.classList.add('hidden'); }, 2000);
  });
</script>

<style is:global>
  .section { padding: 0 !important; }
  .prose { max-width: none !important; width: 100% !important; }
  .content p { @apply mb-4 text-lg leading-[1.8] text-dark/80 dark:text-white/70 font-sans text-left !important; }

  /* SMART QUOTE: RAMPING & TANPA GARIS (image_5412a3.png fix) */
  .content blockquote { 
    @apply bg-gray-50/70 dark:bg-white/5 px-10 py-6 italic text-xl md:text-2xl font-medium text-[#0b1c3c] dark:text-white my-4 relative overflow-hidden;
    border: none !important; 
    padding-left: 3.5rem !important;
  }
  .content blockquote::before {
    content: "“";
    @apply absolute top-0 left-4 text-7xl text-primary/10 font-serif leading-none select-none;
  }
  
  .content h2 { @apply text-3xl md:text-4xl font-black uppercase mt-12 mb-4 text-[#0b1c3c] dark:text-white tracking-tight leading-tight block break-words; border: none !important; padding: 0 !important; }
  .content img { @apply rounded-none my-6 shadow-xl mx-auto h-auto border border-gray-100 dark:border-white/5 w-full; }
</style>