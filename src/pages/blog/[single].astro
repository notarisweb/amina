---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { BiCalendarEdit, BiUserCircle, BiChevronRight, BiShareAlt } from "react-icons/bi";
import { FaFacebookF, FaWhatsapp, FaPinterestP, FaTelegramPlane } from "react-icons/fa";

export const prerender = false;
const { single } = Astro.params;
const WP_URL = import.meta.env.PUBLIC_WP_URL;
const currentUrl = Astro.url;

const query = {
  query: `
    query GetPostAndAllCategories($id: ID!) {
      post(id: $id, idType: SLUG) {
        title
        content
        date
        excerpt
        author { node { name } }
        categories { nodes { name } }
        featuredImage { node { sourceUrl } }
      }
      posts(first: 50) { 
        nodes {
          title
          slug
          categories { nodes { name } }
          featuredImage { node { sourceUrl } }
        }
      }
      categories(first: 100) { 
        nodes {
          name
          slug
          count
        }
      }
    }
  `,
  variables: { id: single },
};

let postData;
let allPosts = [];
let sidebarCategories = [];

try {
  const response = await fetch(WP_URL, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(query),
  });
  const result = await response.json();
  postData = result.data?.post;
  allPosts = result.data?.posts?.nodes || [];
  // Memastikan kategori yang tampil adalah yang memiliki konten
  sidebarCategories = result.data?.categories?.nodes?.filter((c: any) => c.count > 0) || [];
} catch (error) {
  console.error("Gagal fetch data WordPress:", error);
}

if (!postData) return Astro.redirect("/404");

const post = {
  content: postData.content,
  data: {
    title: postData.title,
    description: postData.excerpt,
    date: postData.date,
    image: postData.featuredImage?.node?.sourceUrl || "/images/placeholder.png",
    categories: postData.categories?.nodes.map((c: any) => c.name) || ["Artikel Islami"],
    authors: [postData.author?.node?.name || "Admin"],
  }
};

const formattedAllPosts = allPosts.map((p: any) => ({
  slug: p.slug,
  data: {
    title: p.title,
    image: p.featuredImage?.node?.sourceUrl || "/images/placeholder.png",
    categories: p.categories?.nodes.map((c: any) => c.name) || [],
  }
}));

const primaryCategory = post.data.categories[0] || "Berita";
const popularPosts = formattedAllPosts.slice(0, 5);

// Logika Postingan Terkait (berdasarkan kategori yang sama)
const relatedPosts = formattedAllPosts
  .filter(p => p.slug !== single && p.data.categories.some(cat => post.data.categories.includes(cat)))
  .slice(0, 3);

const shareLinks = [
  { name: 'Facebook', icon: FaFacebookF, color: '#1877F2', url: `https://www.facebook.com/sharer/sharer.php?u=${currentUrl}` },
  { name: 'WhatsApp', icon: FaWhatsapp, color: '#25D366', url: `https://api.whatsapp.com/send?text=${post.data.title} ${currentUrl}` },
  { name: 'Pinterest', icon: FaPinterestP, color: '#E60023', url: `https://pinterest.com/pin/create/button/?url=${currentUrl}&media=${post.data.image}&description=${post.data.title}` },
  { name: 'Telegram', icon: FaTelegramPlane, color: '#0088cc', url: `https://t.me/share/url?url=${currentUrl}&text=${post.data.title}` },
];
---

<Base title={post.data.title} description={post.data.description} image={post.data.image}>
  <div id="progress-container" class="fixed top-0 left-0 w-full h-1.5 z-[100] bg-transparent">
    <div id="progress-bar" class="h-full bg-primary w-0 transition-all duration-150 ease-out shadow-[0_0_10px_rgba(var(--color-primary),0.5)]"></div>
  </div>

  <section class="bg-[#0b1c3c] py-12 md:py-20 text-white w-full border-t border-white/5 relative overflow-hidden">
    <div class="container relative z-10">
      <nav class="flex items-center space-x-2 text-[10px] md:text-[11px] mb-8 text-white/40 font-bold uppercase tracking-[0.2em]">
        <a href="/" class="hover:text-primary transition">BERANDA</a>
        <BiChevronRight className="opacity-20" />
        <a href={`/categories/${slugify(primaryCategory)}`} class="hover:text-primary transition">{primaryCategory}</a>
        <BiChevronRight className="opacity-20" />
        <span class="text-primary italic normal-case font-medium line-clamp-1 opacity-80">{post.data.title}</span>
      </nav>
      <h1 set:html={post.data.title} class="text-3xl md:text-6xl text-white font-black leading-[1.1] mb-10 max-w-4xl" />
      <div class="flex flex-wrap items-center gap-8 text-[11px] font-bold text-white/60 uppercase tracking-widest border-t border-white/10 pt-10">
        <span class="flex items-center"><BiUserCircle className="mr-2 h-5 w-5 text-primary" /> {post.data.authors[0]}</span>
        <span class="flex items-center"><BiCalendarEdit className="mr-2 h-5 w-5 text-primary" /> {dateFormat(post.data.date)}</span>
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#fcfcfc] text-left">
    <div class="container">
      <div class="flex flex-wrap lg:flex-nowrap gap-12">
        <article class="w-full lg:w-[68%]">
          {post.data.image && (
            <div class="mb-12 overflow-hidden rounded-xl shadow-xl aspect-video relative group">
              <img src={post.data.image} class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-105" alt={post.data.title} />
            </div>
          )}

          <div class="flex items-center gap-3 mb-10 pb-6 border-b border-gray-100">
             <span class="text-[11px] font-bold text-dark/40 uppercase tracking-widest mr-2 flex items-center">
                <BiShareAlt className="mr-1 h-4 w-4" /> Share:
             </span>
             {shareLinks.map((item) => (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-lg text-white transition hover:scale-110 shadow-sm" style={{ backgroundColor: item.color }}>
                   <item.icon className="h-4 w-4" />
                </a>
             ))}
          </div>

          <div class="content prose prose-lg md:prose-xl max-w-none text-dark/80 leading-[1.8] first-letter:text-5xl first-letter:font-black first-letter:text-primary first-letter:mr-3 first-letter:float-left" set:html={post.content} />

          {relatedPosts.length > 0 && (
            <div class="mt-20 pt-12 border-t border-gray-200">
              <h2 class="text-2xl font-black mb-10 text-dark flex items-center tracking-tight">
                <span class="w-8 h-1 bg-primary mr-4 rounded-full"></span>
                BACA JUGA
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {relatedPosts.map((rp) => (
                  <a href={`/blog/${rp.slug}`} class="group">
                    <div class="aspect-video rounded-lg overflow-hidden mb-4 shadow-md bg-gray-200">
                      <img src={rp.data.image} class="w-full h-full object-cover group-hover:scale-110 transition duration-500" alt={rp.data.title} />
                    </div>
                    <h3 class="text-sm font-black leading-tight group-hover:text-primary transition line-clamp-2 uppercase">
                      {rp.data.title}
                    </h3>
                  </a>
                ))}
              </div>
            </div>
          )}
        </article>

        <aside class="w-full lg:w-[32%]">
          <div class="sticky top-24 space-y-10">
            <div class="bg-white p-6 rounded-xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100">
              <h2 class="text-xs font-black mb-8 text-dark flex items-center tracking-widest uppercase">
                <span class="w-1 h-4 bg-primary mr-3 rounded-full"></span>
                Terpopuler
              </h2>
              <ul class="space-y-6">
                {popularPosts.map((p) => (
                  <li class="group">
                    <a href={`/blog/${p.slug}`} class="flex gap-4 items-center">
                      <div class="w-16 h-12 shrink-0 overflow-hidden rounded-lg shadow-sm bg-gray-50 relative">
                        <img src={p.data.image} class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition duration-500" alt={p.data.title} />
                      </div>
                      <div class="flex-1">
                        <h3 class="text-[11px] font-bold leading-tight text-dark group-hover:text-primary transition line-clamp-2 uppercase">
                          {p.data.title}
                        </h3>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <div class="bg-[#0b1c3c] p-6 rounded-xl shadow-xl border border-white/5">
              <h2 class="text-xs font-black mb-6 text-white uppercase tracking-[0.2em] border-b border-white/10 pb-4 flex justify-between items-center">
                <span>Kategori</span>
                <span class="text-[10px] text-primary italic opacity-70">Pilihan</span>
              </h2>
              <ul class="space-y-3">
                {sidebarCategories.map((category) => (
                  <li class="group">
                    <a href={`/categories/${category.slug}`} class="flex items-center justify-between text-[12px] font-bold text-white/70 hover:text-primary transition">
                      <span class="group-hover:translate-x-1 transition-transform">{category.name}</span>
                      <span class="bg-white/5 text-white/30 px-2 py-0.5 rounded text-[9px] group-hover:bg-primary group-hover:text-white transition">
                        {category.count}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  window.addEventListener('scroll', () => {
    const progressBar = document.getElementById('progress-bar');
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    if (progressBar) {
      progressBar.style.width = scrolled + "%";
    }
  });
</script>