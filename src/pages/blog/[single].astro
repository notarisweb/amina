---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { slugify } from "@/lib/utils/textConverter";
import { 
  BiCalendarEdit, BiUserCircle, BiChevronRight, BiShareAlt, 
  BiTimeFive, BiListUl, BiShow, BiCopy, BiCheck, 
  BiHeart, BiRightArrowAlt 
} from "react-icons/bi";
import { FaFacebookF, FaWhatsapp, FaTelegramPlane } from "react-icons/fa";

export const prerender = true;

function escapeRegExp(string) {
  return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

export async function getStaticPaths() {
  const WP_URL = import.meta.env.PUBLIC_WP_URL;
  const query = {
    query: `
      query GetStaticBuildData {
        posts(first: 1000) {  /* FIX: Limit 1000 agar artikel lama tidak 404 */
          nodes {
            slug
            title
            content
            date
            excerpt
            author { node { name } }
            categories { nodes { name slug } }
            featuredImage { node { sourceUrl } }
          }
        }
        categories(first: 30) { 
          nodes { name slug count }
        }
      }
    `,
  };

  try {
    const response = await fetch(WP_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(query),
    });
    const result = await response.json();
    const rawPosts = result.data?.posts?.nodes || [];
    const allPosts = rawPosts.filter((p: any) => p.slug && p.slug.trim() !== "");
    const sidebarCategories = result.data?.categories?.nodes?.filter((c: any) => c.count > 0) || [];

    return allPosts.map((post: any) => ({
      params: { single: post.slug },
      props: { post, allPosts, sidebarCategories },
    }));
  } catch (e) {
    console.error("Gagal build paths:", e);
    return [];
  }
}

const { post, allPosts, sidebarCategories } = Astro.props;
const currentUrl = Astro.url;
const donationUrl = "https://bdp.amina.or.id/#donasi"; 

const primaryCategory = post.categories?.nodes?.[0]?.name || "Berita";
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug && p.categories?.nodes.some(cat => cat.name === primaryCategory))
  .slice(0, 3);

// --- TABLE OF CONTENTS ---
const headings = post.content.match(/<h[2-3][^>]*>.*?<\/h[2-3]>/g) || [];
const toc = headings.map((h) => {
  const text = h.replace(/<[^>]*>/g, '').trim();
  const id = slugify(text);
  const depth = h.includes('h2') ? 2 : 3;
  return { text, id, depth };
});

let contentWithIds = post.content;
toc.forEach((item) => {
  const headingTag = item.depth === 2 ? 'h2' : 'h3';
  const searchPattern = new RegExp(`<${headingTag}[^>]*>${escapeRegExp(item.text)}<\/${headingTag}>`, 'g');
  contentWithIds = contentWithIds.replace(searchPattern, `<${headingTag} id="${item.id}">${item.text}</${headingTag}>`);
});

const readingTime = Math.ceil(post.content.split(' ').length / 200);
const popularPosts = allPosts.filter(p => p.slug !== post.slug).slice(0, 5);
const rankColors = ["text-blue-400/30", "text-green-400/30", "text-red-400/30", "text-yellow-400/30", "text-purple-400/30"];

const shareLinks = [
  { name: 'Facebook', icon: FaFacebookF, color: '#1877F2', url: `https://www.facebook.com/sharer/sharer.php?u=${currentUrl}` },
  { name: 'WhatsApp', icon: FaWhatsapp, color: '#25D366', url: `https://api.whatsapp.com/send?text=${post.title} ${currentUrl}` },
  { name: 'Telegram', icon: FaTelegramPlane, color: '#0088cc', url: `https://t.me/share/url?url=${currentUrl}&text=${post.title}` },
];
---

<Base 
  title={post.title} 
  description={post.excerpt} 
  image={post.featuredImage?.node?.sourceUrl}
  articleDate={post.date}
  articleAuthor={post.author?.node?.name}
>
  <section class="bg-[#0b1c3c] py-8 md:py-12 text-white w-full border-t border-white/5 relative overflow-hidden transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 lg:px-8 relative z-10">
      <nav class="flex items-center space-x-2 text-[10px] mb-4 text-white/40 font-bold uppercase tracking-[0.2em]">
        <a href="/" class="hover:text-primary transition">Home</a>
        <BiChevronRight className="opacity-20" />
        <a href={`/categories/${post.categories?.nodes?.[0]?.slug}`} class="hover:text-primary transition">{primaryCategory}</a>
      </nav>
      <h1 set:html={post.title} class="text-3xl md:text-5xl lg:text-6xl text-white font-black leading-[1.1] mb-6 max-w-5xl tracking-tighter drop-shadow-sm" />
      <div class="flex flex-wrap items-center gap-6 text-[10px] font-bold text-white/30 uppercase tracking-widest border-t border-white/5 pt-6">
        <span class="flex items-center"><BiUserCircle className="mr-1.5 h-4 w-4 text-primary" /> {post.author?.node?.name}</span>
        <span class="flex items-center"><BiCalendarEdit className="mr-1.5 h-4 w-4 text-primary" /> {dateFormat(post.date)}</span>
        <span class="flex items-center bg-white/5 px-2.5 py-1 rounded-full"><BiTimeFive className="mr-1.5 h-3.5 w-3.5 text-primary" /> {readingTime} MIN BACA</span>
      </div>
    </div>
  </section>

  <section class="py-12 bg-[#fcfcfc] dark:bg-dark transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 lg:px-8">
      <div class="flex flex-wrap lg:flex-nowrap gap-12">
        
        <article class="w-full lg:w-[68%]">
          {post.featuredImage?.node?.sourceUrl && (
            <div class="mb-10 overflow-hidden rounded-3xl shadow-2xl aspect-video relative group bg-gray-100 dark:bg-white/5 border border-gray-100 dark:border-white/5">
              <Image 
                src={post.featuredImage.node.sourceUrl} 
                width={1200} 
                height={675} 
                format="webp" 
                loading="eager" 
                fetchpriority="high" 
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                alt={post.title || "Gambar Utama"} 
              />
            </div>
          )}

          <div class="flex items-center gap-3 mb-10 pb-6 border-b border-gray-100 dark:border-white/5">
             <span class="text-[10px] font-black text-dark/40 dark:text-white/40 uppercase tracking-widest mr-2 flex items-center"><BiShareAlt className="mr-1 h-3 w-3" /> BAGIKAN:</span>
             {shareLinks.map((item) => (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-xl text-white transition hover:scale-110 shadow-sm" style={{ backgroundColor: item.color }} title={item.name}><item.icon className="h-4 w-4" /></a>
             ))}
             <button id="copy-link-btn" class="w-9 h-9 flex items-center justify-center rounded-xl bg-gray-200 dark:bg-white/10 text-dark/60 dark:text-white/60 transition hover:bg-primary dark:hover:bg-primary hover:text-white dark:hover:text-white shadow-sm group" title="Copy Link">
                <BiCopy id="icon-copy" className="h-4 w-4" />
                <BiCheck id="icon-check" className="h-4 w-4 hidden text-white" />
             </button>
          </div>

          <div class="content prose prose-lg md:prose-xl max-w-none text-dark/80 dark:text-white/80 leading-[1.8] mb-16" set:html={post.content} />

          {relatedPosts.length > 0 && (
            <div class="mb-16 pt-10 border-t border-gray-100 dark:border-white/10">
              <h2 class="text-lg font-black text-dark dark:text-white mb-8 flex items-center uppercase tracking-tight">
                <span class="w-1.5 h-6 bg-primary mr-3 rounded-full"></span> Artikel Terkait
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {relatedPosts.map((rp) => (
                  <a href={`/blog/${rp.slug}`} class="group flex flex-col bg-white dark:bg-white/5 rounded-2xl overflow-hidden shadow-sm border border-gray-50 dark:border-white/5 hover:shadow-xl transition-all duration-300 h-full">
                    <div class="aspect-video overflow-hidden bg-gray-100 dark:bg-white/5">
                      <Image 
                        src={rp.featuredImage?.node?.sourceUrl || "/images/placeholder.png"} 
                        width={400} 
                        height={225} 
                        class="w-full h-full object-cover group-hover:scale-110 transition duration-500" 
                        alt={rp.title || "Thumbnail Terkait"} 
                      />
                    </div>
                    <div class="p-4 flex-1 flex flex-col justify-between">
                      <h3 class="text-[14px] font-black leading-snug text-dark/90 dark:text-white/90 group-hover:text-primary transition line-clamp-2 mb-3 tracking-tight">{rp.title}</h3>
                      <div class="text-[10px] font-bold text-dark/30 dark:text-white/30 uppercase tracking-widest flex items-center"><BiTimeFive className="mr-1 h-3 w-3" /> {dateFormat(rp.date)}</div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="bg-gradient-to-br from-orange-50 via-white to-green-50 dark:from-[#004d40]/20 dark:via-dark dark:to-orange-600/10 p-8 md:p-12 rounded-[2.5rem] shadow-xl border border-orange-100 dark:border-white/5 relative overflow-hidden transition-all">
            <div class="relative z-10 flex flex-col md:flex-row items-center gap-8">
               <div class="flex-1 text-center md:text-left">
                  <div class="inline-flex items-center gap-2 px-3 py-1 bg-orange-600/10 dark:bg-orange-600/20 rounded-full mb-4">
                     <BiHeart className="text-orange-600 h-4 w-4 animate-pulse" />
                     <span class="text-[10px] font-black uppercase tracking-widest text-orange-700 dark:text-orange-400">Mari Berbagi</span>
                  </div>
                  <h2 class="text-2xl md:text-3xl font-black mb-3 leading-tight tracking-tight uppercase text-[#004d40] dark:text-teal-400">
                    Sedekah Anda, Harapan Mereka
                  </h2>
                  <p class="text-slate-600 dark:text-gray-400 text-xs md:text-sm font-bold leading-relaxed uppercase tracking-wider">
                    Setiap bantuan Anda sangat berarti untuk kemanusiaan melalui program Amina. Salurkan donasi terbaik Anda hari ini.
                  </p>
               </div>

               <div class="shrink-0 w-full md:w-auto">
                  <a href={donationUrl} target="_blank" class="w-full bg-orange-600 hover:bg-[#004d40] text-white font-black uppercase tracking-widest py-5 px-10 rounded-2xl text-[13px] flex items-center justify-center transition-all duration-300 shadow-lg hover:shadow-orange-200 dark:hover:shadow-none hover:scale-105 group">
                    Donasi Sekarang <BiRightArrowAlt className="ml-2 h-5 w-5 group-hover:translate-x-1 transition" />
                  </a>
               </div>
            </div>
          </div>
        </article>

        <aside class="w-full lg:w-[32%]">
          <div class="sticky top-24 space-y-12">
            {toc.length > 0 && (
              <div class="bg-white dark:bg-white/5 p-8 rounded-[2rem] shadow-sm border border-gray-100 dark:border-white/5">
                <h2 class="text-[11px] font-black mb-6 text-dark dark:text-white flex items-center tracking-[0.2em] uppercase"><BiListUl className="mr-3 h-5 w-5 text-primary" /> DAFTAR ISI</h2>
                <nav class="space-y-4">
                  {toc.map((item) => (
                    <a href={`#${item.id}`} class={`block text-[13px] transition hover:text-primary leading-tight ${item.depth === 3 ? 'ml-6 text-dark/40 dark:text-white/30 font-medium' : 'text-dark/70 dark:text-white/70 font-bold'}`}>{item.text}</a>
                  ))}
                </nav>
              </div>
            )}
            
            <div class="bg-white dark:bg-white/5 p-8 rounded-[2rem] shadow-sm border border-gray-100 dark:border-white/5 transition-colors">
              <h2 class="text-lg font-black text-[#0b1c3c] dark:text-teal-400 flex items-center mb-8 uppercase tracking-tight"><span class="w-1.5 h-6 bg-primary mr-3 rounded-full"></span>Terpopuler</h2>
              <ul class="space-y-8">
                {popularPosts.map((p: any, index: number) => (
                  <li class="group relative flex gap-5">
                    <span class={`text-4xl font-black italic transition duration-500 leading-none ${rankColors[index % rankColors.length]}`}>0{index + 1}</span>
                    <div class="flex-1 min-w-0">
                      <a href={`/blog/${p.slug}`} class="block">
                        <h3 class="text-[15px] font-black text-dark/90 dark:text-white/90 group-hover:text-primary transition leading-snug mb-2 tracking-tight line-clamp-2">
                          {p.title}
                        </h3>
                      </a>
                      <div class="flex items-center gap-2 text-[9px] font-black uppercase tracking-widest text-primary">
                         <span>{p.categories?.nodes?.[0]?.name || "BERITA"}</span>
                         <span class="text-dark/10 dark:text-white/10">•</span>
                         <span class="flex items-center gap-1 text-dark/30 dark:text-white/30"><BiShow className="h-3 w-3" /> {Math.floor(Math.random() * 4000) + 500}</span>
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ postUrl: currentUrl.href }}>
  // Copy Link Script
  document.getElementById('copy-link-btn')?.addEventListener('click', function() {
    const iconCopy = document.getElementById('icon-copy');
    const iconCheck = document.getElementById('icon-check');
    const btn = this;
    navigator.clipboard.writeText(postUrl).then(() => {
      iconCopy.classList.add('hidden');
      iconCheck.classList.remove('hidden');
      btn.classList.add('bg-green-500', 'text-white');
      setTimeout(() => {
        iconCopy.classList.remove('hidden');
        iconCheck.classList.add('hidden');
        btn.classList.remove('bg-green-500', 'text-white');
      }, 2000);
    });
  });
</script>