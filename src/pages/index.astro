---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Posts from "@/components/Posts.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import config from "@/config/config.json";
import dateFormat from "@/lib/utils/dateFormat";
import { BiTrendingUp, BiTimeFive, BiUserCircle, BiChevronRight } from "react-icons/bi";

export const prerender = true; 

const WP_URL = import.meta.env.PUBLIC_WP_URL;
const query = {
  query: `query GetHomepageData {
    posts(first: 15) {
      nodes {
        title slug excerpt date
        author { node { name } }
        categories { nodes { name slug } }
        featuredImage { node { sourceUrl } }
      }
    }
  }`,
};

let currentPosts = [];
try {
  const res = await fetch(WP_URL, { 
    method: "POST", 
    headers: { "Content-Type": "application/json" }, 
    body: JSON.stringify(query) 
  });
  const result = await res.json();
  const raw = result.data?.posts?.nodes || [];
  
  currentPosts = raw.filter(p => p.slug).map(post => ({
    slug: post.slug,
    data: {
      title: post.title,
      date: post.date,
      image: post.featuredImage?.node?.sourceUrl || "/images/placeholder.png",
      categories: post.categories?.nodes.map(c => c.name) || ["Berita"],
      authors: [post.author?.node?.name || "Admin"],
      excerpt: post.excerpt || ""
    }
  }));
} catch (e) { 
  console.error("Gagal Fetch Data:", e); 
}

const featuredPost = currentPosts[0];
const secondaryPosts = currentPosts.slice(1, 4);
const listPosts = currentPosts.slice(4);
const totalPages = Math.ceil(currentPosts.length / config.settings.pagination);
---

<Base title="Portal Berita Islami & Sosial">
  <div class="bg-white border-b border-gray-100 py-3 w-full">
    <div class="container flex items-center">
      <div class="flex items-center gap-2 bg-[#0b1c3c] text-white px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest mr-6 shrink-0 shadow-lg shadow-[#0b1c3c]/10">
        <BiTrendingUp className="h-4 w-4 text-primary" /> Trending
      </div>
      <div class="flex-1 overflow-hidden">
        <div class="flex gap-12 animate-marquee whitespace-nowrap text-[11px] font-bold text-dark/60 uppercase">
          {currentPosts.map(p => (
            <a href={`/blog/${p.slug}`} class="hover:text-primary transition shrink-0">
              {p.data.title} <span class="ml-12 text-gray-200">|</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <section class="py-10 md:py-16 bg-[#fcfcfc] overflow-hidden">
    <div class="container">
      {featuredPost && (
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10 items-start">
          
          <div class="lg:col-span-2 w-full">
            <a href={`/blog/${featuredPost.slug}`} class="relative block overflow-hidden rounded-[2.5rem] shadow-xl group bg-[#0b1c3c] aspect-video lg:h-[550px] w-full">
              <Image 
                src={featuredPost.data.image} 
                width={1400} 
                height={900} 
                format="webp" 
                loading="eager" 
                fetchpriority="high"
                class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:scale-105 transition duration-1000 group-hover:opacity-75" 
                alt={featuredPost.data.title} 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0b1c3c] via-[#0b1c3c]/20 to-transparent"></div>
              
              <div class="absolute bottom-0 left-0 p-8 md:p-14 w-full z-10">
                <span class="inline-block bg-primary text-[#0b1c3c] text-[10px] font-black px-4 py-1.5 rounded-full uppercase mb-6 tracking-[0.2em] shadow-lg shadow-primary/20">
                  {featuredPost.data.categories[0]}
                </span>
                <h2 class="text-3xl md:text-5xl lg:text-6xl font-black text-white leading-[1.1] mb-6 uppercase tracking-tighter drop-shadow-sm" set:html={featuredPost.data.title} />
                <div class="flex items-center gap-6 text-[10px] text-white/50 font-black uppercase tracking-widest">
                  <span class="flex items-center gap-2"><BiUserCircle className="text-primary h-4 w-4" /> {featuredPost.data.authors[0]}</span>
                  <span class="flex items-center gap-2"><BiTimeFive className="text-primary h-4 w-4" /> {dateFormat(featuredPost.data.date)}</span>
                </div>
              </div>
            </a>
          </div>

          <div class="lg:col-span-1 w-full flex flex-col gap-6">
            {secondaryPosts.map(p => (
              <a href={`/blog/${p.slug}`} class="flex gap-5 p-4 bg-white rounded-[2rem] border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-500 group items-center w-full">
                <div class="w-24 h-24 lg:w-28 lg:h-28 shrink-0 overflow-hidden rounded-2xl bg-gray-100 shadow-inner">
                  <Image src={p.data.image} width={300} height={300} format="webp" class="w-full h-full object-cover group-hover:scale-110 transition duration-500" alt={p.data.title} />
                </div>
                <div class="flex-1 min-w-0">
                  <span class="text-[9px] font-black text-primary uppercase mb-2 block tracking-widest">{p.data.categories[0]}</span>
                  <h3 class="text-sm lg:text-[15px] font-black text-[#0b1c3c] group-hover:text-primary transition line-clamp-2 uppercase tracking-tight leading-snug" set:html={p.data.title} />
                </div>
              </a>
            ))}
          </div>

        </div>
      )}
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="flex items-end justify-between border-b border-gray-100 pb-8 mb-12">
        <div>
          <h2 class="text-[10px] font-black text-primary uppercase tracking-[0.4em] mb-3">Feed Terbaru</h2>
          <p class="text-4xl font-black text-[#0b1c3c] tracking-tighter uppercase">Kabar Amina Media</p>
        </div>
        <a href="/categories/berita" class="hidden md:flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-dark/30 hover:text-primary transition">
          Lihat Semua <BiChevronRight className="h-4 w-4" />
        </a>
      </div>
      
      <Posts posts={listPosts} className="mb-16" />
      
      {totalPages > 1 && (
        <div class="flex justify-center mt-12 pb-20">
          <Pagination currentPage={1} totalPages={totalPages} />
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  /* CSS Murni agar aman di Tailwind v4 */
  @keyframes marquee { 
    0% { transform: translateX(0); } 
    100% { transform: translateX(-50%); } 
  }
  .animate-marquee { 
    display: flex; 
    animation: marquee 40s linear infinite; 
    width: max-content; 
  }
  .animate-marquee:hover { 
    animation-play-state: paused; 
  }
</style>