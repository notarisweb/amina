---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Posts from "@/components/Posts.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import config from "@/config/config.json";
import dateFormat from "@/lib/utils/dateFormat";
import { BiTrendingUp, BiTimeFive, BiChevronRight, BiUserCircle } from "react-icons/bi";

export const prerender = true; 

const WP_URL = import.meta.env.PUBLIC_WP_URL;

const query = {
  query: `
    query GetHomepageData {
      posts(first: 13) {
        nodes {
          title
          slug
          excerpt
          date
          author { node { name } }
          categories { nodes { name slug } }
          featuredImage { node { sourceUrl } }
        }
      }
      categories(first: 6) {
        nodes {
          name
          slug
          count
        }
      }
    }
  `,
};

let currentPosts = [];
let allCategories = [];

try {
  const response = await fetch(WP_URL, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(query),
  });
  const result = await response.json();
  const wpPosts = result.data?.posts?.nodes || [];
  allCategories = result.data?.categories?.nodes?.filter((c: any) => c.count > 0) || [];

  currentPosts = wpPosts.map((post: any) => ({
    id: post.slug, 
    slug: post.slug,
    body: post.excerpt || "",
    data: {
      title: post.title || "Judul Tidak Tersedia",
      description: post.excerpt || "", 
      date: post.date,
      image: post.featuredImage?.node?.sourceUrl || "/images/placeholder.png",
      categories: post.categories?.nodes.map((c: any) => c.name) || ["Berita"],
      authors: [post.author?.node?.name || "Admin"],
    }
  }));
} catch (e) {
  console.error("Gagal ambil data:", e);
}

const featuredPost = currentPosts[0];
const secondaryPosts = currentPosts.slice(1, 4);
const listPosts = currentPosts.slice(4);
const totalPages = Math.ceil(currentPosts.length / config.settings.pagination);
---

<Base title="Portal Berita Islami & Sosial">
  <div class="max-w-[1100px] mx-auto overflow-hidden">
    
    <div class="bg-white border-b border-gray-100 py-3 mt-4 rounded-t-3xl shadow-sm overflow-hidden">
      <div class="px-6 flex items-center">
        <div class="flex items-center gap-2 bg-[#0b1c3c] text-white px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest mr-6 shrink-0 shadow-lg shadow-primary/20 z-10">
          <BiTrendingUp className="h-4 w-4 text-primary" /> Trending
        </div>
        <div class="flex-1 overflow-hidden">
          <div class="flex gap-12 animate-marquee whitespace-nowrap text-[11px] font-bold text-dark/60 uppercase">
            {currentPosts.map(p => (
              <a href={`/blog/${p.slug}`} class="hover:text-primary transition shrink-0">
                {p.data.title} <span class="ml-12 text-gray-200">|</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <section class="py-8 bg-[#fcfcfc]">
      <div class="px-4">
        {featuredPost && (
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <div class="lg:col-span-8">
              <a href={`/blog/${featuredPost.slug}`} class="relative block overflow-hidden rounded-3xl shadow-2xl aspect-video lg:h-[520px] group bg-dark">
                <Image 
                  src={featuredPost.data.image} 
                  width={1200} 
                  height={800} 
                  format="webp"
                  loading="eager" 
                  fetchpriority="high" 
                  class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-105 transition duration-1000 group-hover:opacity-60" 
                  alt={featuredPost.data.title} 
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0b1c3c] via-dark/10 to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-8 md:p-12 w-full">
                  <span class="inline-block bg-primary text-[#0b1c3c] text-[10px] font-black px-4 py-1 rounded-full uppercase mb-6 tracking-widest">{featuredPost.data.categories[0]}</span>
                  <h2 class="text-3xl md:text-5xl font-black text-white leading-tight mb-6 uppercase tracking-tighter" set:html={featuredPost.data.title} />
                  <div class="flex items-center gap-6 text-[10px] text-white/60 font-bold uppercase tracking-widest">
                    <span class="flex items-center gap-2"><BiUserCircle className="text-primary h-4 w-4" /> {featuredPost.data.authors[0]}</span>
                    <span class="flex items-center gap-2"><BiTimeFive className="text-primary h-4 w-4" /> {dateFormat(featuredPost.data.date)}</span>
                  </div>
                </div>
              </a>
            </div>

            <div class="lg:col-span-4 space-y-6">
              {secondaryPosts.map(p => (
                <a href={`/blog/${p.slug}`} class="flex gap-4 p-5 bg-white rounded-3xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 group items-center">
                  <div class="w-24 h-24 shrink-0 overflow-hidden rounded-2xl bg-gray-100">
                    <Image src={p.data.image} width={200} height={200} format="webp" class="w-full h-full object-cover group-hover:scale-110 transition duration-500" alt={p.data.title} />
                  </div>
                  <div>
                    <span class="text-[9px] font-black text-primary uppercase mb-1 block tracking-widest">{p.data.categories[0]}</span>
                    <h3 class="text-sm font-black text-[#0b1c3c] group-hover:text-primary transition line-clamp-2 uppercase tracking-tight" set:html={p.data.title} />
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <section class="py-16">
      <div class="px-4">
        <div class="border-b border-gray-100 pb-8 mb-12 flex justify-between items-end">
          <div>
            <h2 class="text-[10px] font-black text-primary uppercase tracking-[0.4em] mb-3">Feed Terbaru</h2>
            <p class="text-4xl font-black text-[#0b1c3c] tracking-tighter uppercase">Kabar Amina Media</p>
          </div>
          <a href="/categories/berita" class="text-[10px] font-black uppercase tracking-widest text-dark/40 hover:text-primary transition flex items-center">
            Lihat Semua <BiChevronRight className="h-4 w-4" />
          </a>
        </div>
        
        <Posts posts={listPosts} className="mb-16" />
        
        {totalPages > 1 && (
          <div class="flex justify-center mt-12 pb-20">
            <Pagination currentPage={1} totalPages={totalPages} />
          </div>
        )}
      </div>
    </section>

  </div> </Base>

<style>
  @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  .animate-marquee { display: flex; animation: marquee 45s linear infinite; width: max-content; }
  .animate-marquee:hover { animation-play-state: paused; }
</style>