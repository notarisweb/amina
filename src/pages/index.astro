---
import Base from "@/layouts/Base.astro";
import TrendingTicker from "@/components/homepage/TrendingTicker.astro";
import LatestUpdates from "@/components/homepage/LatestUpdates.astro";
import MainHeadline from "@/components/homepage/MainHeadline.astro";
import TrendingNews from "@/components/homepage/TrendingNews.astro";
import ArtikelIslamiBlock from "@/components/homepage/ArtikelIslamiBlock.astro";
import KataUstadz from "@/components/homepage/KataUstadz.astro";
import NationalFeed from "@/components/homepage/NationalFeed.astro";
import Sidebar from "@/components/homepage/Sidebar.astro";

export const prerender = true;

// --- CONFIG ID KATEGORI AMINA ---
const ID_BERITA = 26;          
const ID_ARTIKEL_ISLAMI = 29; 
const ID_KATA_USTADZ = 46;    

const API_BASE = "https://studio.amina.or.id/wp-json/wp/v2/posts?_embed";

// 1. HELPER: Bersihkan HTML & Karakter Aneh
const cleanText = (str: string) => {
  if (!str) return "";
  return str
    .replace(/<[^>]*>/g, "")
    .replace("[&hellip;]", "...")
    .replace("&nbsp;", " ")
    .replace("&#8217;", "'")
    .replace("&#8211;", "-");
};

// 2. HELPER: Mapping Data (Konsisten untuk Grade A)
const mapWPData = (p: any) => {
  const featuredMedia = p._embedded?.["wp:featuredmedia"]?.[0]?.source_url;
  return {
    slug: p.slug,
    data: {
      title: p.title.rendered,
      excerpt: cleanText(p.excerpt.rendered),
      date: p.date,
      image: featuredMedia ? featuredMedia : "/images/placeholder.jpg",
      categoryNames: p._embedded?.["wp:term"]?.[0]?.map((cat: any) => cat.name) || ["Berita"],
      categoryIds: p.categories || [], 
    },
  };
};

// 3. DEDICATED FETCH: Kecepatan Tinggi (Promise.all)
let generalPosts = [];
let nationalPosts = [];
let artikelIslamiPosts = [];
let kataUstadzPosts = [];

try {
  const [resGen, resBerita, resIslami, resUstadz] = await Promise.all([
    fetch(`${API_BASE}&per_page=20`), // Ambil lebih banyak untuk Ticker + Hero
    fetch(`${API_BASE}&categories=${ID_BERITA}&per_page=10`),
    fetch(`${API_BASE}&categories=${ID_ARTIKEL_ISLAMI}&per_page=6`),
    fetch(`${API_BASE}&categories=${ID_KATA_USTADZ}&per_page=8`)
  ]);

  const [dataGen, dataBerita, dataIslami, dataUstadz] = await Promise.all([
    resGen.json(), resBerita.json(), resIslami.json(), resUstadz.json()
  ]);

  generalPosts = Array.isArray(dataGen) ? dataGen.map(mapWPData) : [];
  nationalPosts = Array.isArray(dataBerita) ? dataBerita.map(mapWPData) : [];
  artikelIslamiPosts = Array.isArray(dataIslami) ? dataIslami.map(mapWPData) : [];
  kataUstadzPosts = Array.isArray(dataUstadz) ? dataUstadz.map(mapWPData) : [];

} catch (err) {
  console.error("Gagal Fetching Data WordPress:", err);
}

// 4. DISTRIBUSI SLOT UI (Grade A Strategy)
const tickerPosts = generalPosts.slice(0, 10); // Berita untuk Running Text
const mainHero = generalPosts[0];
const relatedToMain = generalPosts.slice(1, 3);
const sideLatest = generalPosts.slice(3, 8); 
const trendingPosts = generalPosts.slice(8, 13);
const sidebarPopular = nationalPosts.slice(4, 9);
---

<Base title="Amina Media - Berbagi & Peduli">
  
  <TrendingTicker posts={tickerPosts} />

  <main class="py-6 bg-white dark:bg-dark overflow-x-hidden transition-colors duration-300">
    
    <div class="max-w-7xl mx-auto px-4 lg:px-8 space-y-14">
      
      <section>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
          
          <div class="lg:col-span-3">
            <LatestUpdates posts={sideLatest} />
          </div>

          <div class="lg:col-span-6">
            {mainHero && <MainHeadline post={mainHero} relatedPosts={relatedToMain} />}
          </div>

          <div class="lg:col-span-3">
            <TrendingNews posts={trendingPosts} />
          </div>
          
        </div>
      </section>

      <section class="relative">
        <ArtikelIslamiBlock posts={artikelIslamiPosts} />
      </section>

      <section>
        <KataUstadz posts={kataUstadzPosts} />
      </section>

      <section>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <div class="lg:col-span-8">
            <NationalFeed posts={nationalPosts} />
          </div>
          
          <aside class="lg:col-span-4 sticky top-10">
            <Sidebar popular={sidebarPopular} />
          </aside>
        </div>
      </section>

    </div>
  </main>
</Base>

<style is:global>
  /* Global Typography Amina (Target Grade A) */
  body { 
    font-family: 'Inter', system-ui, -apple-system, sans-serif; 
    -webkit-font-smoothing: antialiased;
  }

  /* Reset Font Weights & Letter Spacing */
  h1, h2, h3, h4 { 
    letter-spacing: -0.02em; 
    text-transform: none; 
    font-weight: 800;
  }

  /* Global Line Clamping (Layout Shield) */
  .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>