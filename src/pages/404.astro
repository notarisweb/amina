---
import Base from "@/layouts/Base.astro";
import TrendingTicker from "@/components/homepage/TrendingTicker.astro";
import { BiHomeAlt, BiSearchAlt, BiChevronRight } from "react-icons/bi";

// Meta data
const title = "Halaman Tidak Ditemukan";
const description = "Maaf, halaman yang Anda cari tidak dapat ditemukan di Amina Media.";

// Kosongkan atau isi ticker dengan fetch berita terbaru jika ingin
const tickerPosts = []; 
---

<Base title={`${title} | Amina Media`} description={description}>
  
  <TrendingTicker posts={tickerPosts} />

  <main class="py-20 bg-white dark:bg-dark transition-colors duration-300 min-h-[75vh] flex items-center">
    <div class="container">
      
      <div class="max-w-4xl mx-auto text-center">
        <div class="relative inline-block mb-12">
          <span class="text-[120px] md:text-[200px] font-black text-gray-100 dark:text-white/5 leading-none select-none">
            404
          </span>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-16 h-16 md:w-24 md:h-24 bg-orange-600 rounded-full flex items-center justify-center shadow-2xl shadow-orange-600/40 animate-pulse">
               <BiSearchAlt className="text-white text-3xl md:text-5xl" />
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <h1 class="text-3xl md:text-5xl font-black text-[#004d40] dark:text-teal-400 tracking-tighter uppercase">
            Afwan, Halaman Tidak Ditemukan
          </h1>
          <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto font-medium leading-relaxed">
            Mungkin halaman telah dipindahkan, dihapus, atau alamat URL yang Anda masukkan kurang tepat. Mari kembali ke jalan yang benar.
          </p>
        </div>

        <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/" 
            class="w-full sm:w-auto flex items-center justify-center gap-3 bg-[#0b1c3c] dark:bg-primary text-white px-10 py-4 rounded-xl font-black text-xs uppercase tracking-widest hover:scale-105 transition shadow-xl shadow-black/10"
          >
            <BiHomeAlt className="text-lg" /> Kembali ke Beranda
          </a>
          
          <a 
            href="/search" 
            class="w-full sm:w-auto flex items-center justify-center gap-3 bg-white dark:bg-white/5 text-[#0b1c3c] dark:text-white border border-gray-100 dark:border-white/10 px-10 py-4 rounded-xl font-black text-xs uppercase tracking-widest hover:bg-gray-50 dark:hover:bg-white/10 transition"
          >
            Cari Artikel <BiChevronRight className="text-lg" />
          </a>
        </div>

        <div class="mt-20 pt-10 border-t border-gray-50 dark:border-white/5">
          <p class="text-[10px] font-black text-gray-300 dark:text-gray-700 uppercase tracking-[0.4em]">
            Amina Media - Amal Insan Abadi
          </p>
        </div>
      </div>

    </div>
  </main>
</Base>

<style is:global>
  /* Mematikan padding default jika ada */
  .section {
    padding: 0 !important;
  }
</style>