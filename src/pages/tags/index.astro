---
import Base from "@/layouts/Base.astro";
import { humanize } from "@/lib/utils/textConverter";
import { FaHashtag } from "react-icons/fa";
import TrendingTicker from "@/components/homepage/TrendingTicker.astro";

// 1. Menggunakan Environment Variable untuk fleksibilitas URL API
const WP_URL = import.meta.env.PUBLIC_WP_URL;

// 2. Query untuk mengambil daftar Tag dari WordPress
const query = {
  query: `
    query GetTags {
      tags(first: 100) {
        nodes {
          name
          slug
          count
        }
      }
      recentPosts: posts(first: 10) {
        nodes {
          title
          slug
        }
      }
    }
  `,
};

let tags = [];
let tickerPosts = [];

try {
  const response = await fetch(WP_URL, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(query),
  });
  const result = await response.json();
  
  const allTags = result.data?.tags?.nodes || [];
  const wpRecent = result.data?.recentPosts?.nodes || [];
  
  // Filter: Hanya tampilkan tag yang memiliki artikel (count > 0)
  tags = allTags.filter((tag: any) => (tag.count || 0) > 0);

  // Mapping untuk Ticker
  tickerPosts = wpRecent.map((p: any) => ({
    slug: p.slug,
    data: { title: p.title }
  }));
} catch (e) {
  console.error("Gagal mengambil tags dari WordPress studio.amina.or.id:", e);
}

const title = "Tag Populer";
---

<Base title={`${title} | Amina Media`}>
  
  <TrendingTicker posts={tickerPosts} />

  <header class="bg-[#0b1c3c] py-16 md:py-24 text-white w-full border-t border-white/5 relative overflow-hidden">
    <div class="container relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-primary/20 text-primary px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest mb-6 border border-primary/20">
          <FaHashtag className="text-sm" /> Topik Spesifik
        </div>
        <h1 class="text-4xl md:text-6xl font-black mb-6 tracking-tighter uppercase leading-[1.1]">
          {title}
        </h1>
        <p class="text-white/50 text-base md:text-lg max-w-xl font-medium leading-relaxed italic">
          Jelajahi berbagai kata kunci populer yang sedang dibahas di jaringan berita dan dakwah Amina Media.
        </p>
      </div>
    </div>
    <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-primary/5 to-transparent pointer-events-none"></div>
  </header>

  <main class="py-20 bg-white dark:bg-dark transition-colors duration-300 min-h-[50vh]">
    <div class="container">
      
      <ul class="flex flex-wrap justify-center gap-4 md:gap-6">
        {
          tags.length > 0 ? (
            tags.map((tag) => (
              <li class="inline-block">
                <a
                  href={`/tags/${tag.slug}`}
                  class="group flex items-center bg-gray-50 dark:bg-[#06142e] px-6 py-4 rounded-2xl border border-gray-100 dark:border-white/5 transition-all duration-300 hover:border-primary/50 hover:bg-white dark:hover:bg-primary/10 hover:shadow-xl hover:shadow-primary/5"
                >
                  <div class="w-8 h-8 rounded-lg bg-white dark:bg-dark flex items-center justify-center mr-3 shadow-sm group-hover:bg-primary transition-colors">
                    <FaHashtag className="text-primary group-hover:text-white transition h-4 w-4" />
                  </div>
                  
                  <span class="font-black text-[#0b1c3c] dark:text-white text-sm md:text-base group-hover:text-primary transition uppercase tracking-tight">
                    {humanize(tag.name || "")}
                  </span>
                  
                  <span class="ml-4 text-[10px] font-black bg-white dark:bg-dark px-2.5 py-1 rounded-full text-dark/40 dark:text-gray-500 border border-gray-100 dark:border-white/5 group-hover:bg-orange-600 group-hover:text-white group-hover:border-transparent transition-all">
                    {tag.count || 0}
                  </span>
                </a>
              </li>
            ))
          ) : (
            <div class="py-20 text-center w-full">
              <div class="max-w-md mx-auto p-10 bg-gray-50 dark:bg-white/5 rounded-3xl border-2 border-dashed border-gray-100 dark:border-white/10">
                <p class="text-gray-400 dark:text-gray-600 italic font-medium">Opps! Belum ada tag yang tersedia saat ini, Bos.</p>
              </div>
            </div>
          )
        }
      </ul>

      <div class="mt-24 pt-10 border-t border-gray-50 dark:border-white/5 text-center">
        <p class="text-[10px] font-black text-gray-300 dark:text-gray-700 uppercase tracking-[0.4em]">
          Eksplorasi Topik Amina Media - Amal Insan Abadi
        </p>
      </div>

    </div>
  </main>
</Base>

<style is:global>
  /* Menghancurkan padding kaku dari class .section bawaan tema */
  .section {
    padding: 0 !important;
  }
</style>