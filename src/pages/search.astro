---
import SearchBar from "@/helpers/SearchBar";
import Base from "@/layouts/Base.astro";
import TrendingTicker from "@/components/homepage/TrendingTicker.astro";

// JALUR FORCE STATIC: Paksa Astro memperlakukan file ini sebagai halaman statis (SSG) agar tidak memicu error NoAdapterInstalled!
export const prerender = true;

// 1. Mengambil URL API dari Environment Variable
const WP_URL = import.meta.env.PUBLIC_WP_URL;

// 2. Query GraphQL (Optimasi untuk Grade A: Ambil yang perlu saja)
const query = {
  query: `
    query GetSearchData {
      posts(first: 100) {
        nodes {
          title
          slug
          excerpt
          content
          date
          author { node { name } }
          categories { nodes { name } }
          featuredImage { node { sourceUrl } }
        }
      }
    }
  `,
};

let searchList = [];
let tickerPosts = [];

if (WP_URL) {
  try {
    const response = await fetch(WP_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(query),
    });
    
    // VALIDASI TAMENG SEARCH: Amankan jika WordPress melempar HTML (Blokir/Error) saat build
    const contentType = response.headers.get("content-type");
    if (response.ok && contentType && contentType.includes("application/json")) {
      const result = await response.json();
      const wpPosts = result.data?.posts?.nodes || [];

      // 3. Mapping data (Konsisten dengan komponen Homepage kita)
      searchList = wpPosts
        .filter((post: any) => post && post.slug)
        .map((post: any) => ({
          slug: post.slug,
          content: (post.content || post.excerpt || ""), 
          data: {
            title: post.title || "Judul Tidak Tersedia", 
            description: post.excerpt || "", 
            date: post.date || new Date().toISOString(),
            image: post.featuredImage?.node?.sourceUrl || "/images/placeholder.png",
            categoryNames: post.categories?.nodes?.map((c: any) => c?.name).filter(Boolean) || ["Berita"],
            authors: [post.author?.node?.name || "Admin"],
          }
        }));
    } else {
      console.error("🚨 TAMENG SEARCH AKTIF: WordPress tidak membalas dengan JSON di halaman pencarian!");
    }

    // Stok untuk Ticker
    tickerPosts = searchList.slice(0, 10);
  } catch (e) {
    console.error("Gagal mengambil data pencarian dari studio.amina.or.id:", e);
  }
}
---

<Base title={`Pencarian Artikel | Amina Media`}>
  
  <TrendingTicker posts={tickerPosts} />

  <main class="py-16 bg-white dark:bg-dark transition-colors duration-300 min-h-[70vh]">
    <div class="container">
      
      <div class="text-center mb-16 max-w-2xl mx-auto">
        <div class="inline-block bg-orange-600 text-white text-[10px] font-black px-3 py-1 uppercase mb-4 tracking-widest">
          Search Center
        </div>
        <h1 class="text-4xl md:text-5xl font-black text-[#004d40] dark:text-teal-400 tracking-tighter uppercase mb-4">
          Cari Artikel
        </h1>
        <p class="text-gray-500 dark:text-gray-400 font-medium leading-relaxed">
          Temukan khazanah keilmuan, doa, dan berita terkini di <span class="text-primary font-bold">amina.or.id</span> dengan kata kunci yang Anda inginkan.
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto bg-gray-50 dark:bg-[#06142e] p-4 md:p-8 rounded-3xl border border-gray-100 dark:border-white/5 shadow-sm transition-colors">
        <SearchBar client:load searchList={searchList} />
      </div>

      <div class="mt-16 text-center">
        <p class="text-[11px] font-black text-gray-300 dark:text-gray-700 uppercase tracking-[0.3em]">
          Tips: Gunakan kata kunci spesifik seperti "Gaza", "Zakat", atau "Doa"
        </p>
      </div>

    </div>
  </main>
</Base>

<style is:global>
  /* Menyesuaikan tampilan SearchBar agar masuk ke gaya Amina Media */
  .search-input {
    @apply w-full py-4 px-6 rounded-xl border-2 border-gray-100 dark:border-white/10 bg-white dark:bg-dark text-[#0b1c3c] dark:text-white font-bold transition-all focus:border-primary focus:ring-0 outline-none !important;
  }
  
  /* Hilangkan padding default section jika mengganggu */
  .section {
    padding: 0 !important;
  }
</style>