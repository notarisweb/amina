---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { render } from "astro:content";
import TrendingTicker from "@/components/homepage/TrendingTicker.astro";

// 1. SSG ENABLED
export const prerender = true;

export async function getStaticPaths() {
  const WP_URL = import.meta.env.PUBLIC_WP_URL;
  
  // Ambil Halaman Lokal (About, etc)
  const localPages = await getSinglePage("pages");
  const localPaths = localPages.map((page) => ({
    params: { regular: page.slug },
    props: { page, isWordPress: false },
  }));

  // Ambil Pages & Posts dari WordPress
  const query = {
    query: `
      query GetAllStaticPaths {
        posts(first: 100) {
          nodes {
            slug
            title
            content
            date
            excerpt
            featuredImage { node { sourceUrl } }
          }
        }
        pages(first: 50) {
          nodes {
            slug
            title
            content
          }
        }
      }
    `,
  };

  let wpPaths = [];
  try {
    const res = await fetch(WP_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(query),
    });
    
    const result = await res.json();
    const wpPosts = result.data?.posts?.nodes || [];
    const wpPages = result.data?.pages?.nodes || [];
    
    wpPaths = [...wpPosts, ...wpPages].map((node: any) => ({
      params: { regular: node.slug },
      props: { 
        isWordPress: true, 
        wpData: {
          title: node.title,
          content: node.content,
          image: node.featuredImage?.node?.sourceUrl || "/images/placeholder.png",
          date: node.date,
          description: node.excerpt?.replace(/<[^>]*>/g, '').slice(0, 160) || ""
        } 
      },
    }));
  } catch (e) {
    console.error("❌ Gagal fetch GraphQL:", e);
  }

  return [...localPaths, ...wpPaths];
}

const { page, isWordPress, wpData } = Astro.props;

// Render konten Markdown jika lokal
let Content;
if (!isWordPress && page) {
  const rendered = await render(page);
  Content = rendered.Content;
}

// Fetch Ticker Data
const WP_URL = import.meta.env.PUBLIC_WP_URL;
let tickerPosts = [];
try {
  const tRes = await fetch(WP_URL, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ query: "{ posts(first: 10) { nodes { slug title } } }" }),
  });
  const tResult = await tRes.json();
  tickerPosts = (tResult.data?.posts?.nodes || []).map((p: any) => ({
    slug: p.slug,
    data: { title: p.title }
  }));
} catch (e) {}

const title = isWordPress ? wpData.title : page.data.title;
---

<Base 
  title={title} 
  description={isWordPress ? wpData.description : page.data.description}
  image={isWordPress ? wpData.image : page.data.image}
>
  <TrendingTicker posts={tickerPosts} />

  <main class="py-20 bg-[#f8fafc] dark:bg-dark transition-colors duration-300 min-h-screen">
    <div class="container max-w-5xl mx-auto px-6">
      
      <div class="mb-20">
        <div class="inline-flex items-center bg-orange-100 dark:bg-orange-600/10 text-orange-600 text-[10px] font-black px-4 py-1.5 rounded-full uppercase mb-8 tracking-[0.2em] border border-orange-200 dark:border-orange-600/20">
          Amina Official Page
        </div>

        <h1 
          set:html={isWordPress ? title : markdownify(title)} 
          class="text-5xl md:text-7xl font-black text-slate-900 dark:text-white tracking-tighter uppercase mb-8 leading-[0.9] lg:max-w-4xl" 
        />
        
        {isWordPress && wpData.date && (
          <div class="flex items-center gap-4 text-[11px] font-black text-slate-400 uppercase tracking-[0.2em]">
            <span class="w-12 h-[2px] bg-orange-600 rounded-full"></span>
            Terbit: {new Date(wpData.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
          </div>
        )}
      </div>

      <div class="bg-white dark:bg-white/5 p-8 md:p-16 rounded-[3rem] shadow-2xl shadow-slate-200/50 dark:shadow-none border border-white dark:border-white/5 relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-orange-600/5 rounded-full blur-3xl -z-10"></div>
        
        <article class="modern-content prose prose-lg md:prose-xl dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 leading-[1.8] font-medium transition-colors">
          {isWordPress ? (
            <div class="wp-content-render" set:html={wpData.content} />
          ) : (
            Content && <Content />
          )}
        </article>
      </div>

    </div>
  </main>
</Base>

<style is:global>
  /* RESET & ALIGNMENT */
  .section { padding: 0 !important; }

  /* MODERN PROSE STYLING */
  .modern-content img { 
    @apply rounded-[2.5rem] my-16 shadow-2xl mx-auto h-auto border-8 border-slate-50 dark:border-white/5 transition-transform duration-700 hover:scale-[1.02]; 
  }
  
  .modern-content h2 { 
    @apply text-slate-900 dark:text-white font-black uppercase mt-20 mb-8 tracking-tighter leading-tight text-3xl md:text-4xl border-l-8 border-orange-600 pl-6; 
  }

  .modern-content h3 { 
    @apply text-slate-900 dark:text-white font-black uppercase mt-14 mb-6 tracking-tighter leading-tight text-2xl md:text-3xl; 
  }
  
  .modern-content p { @apply mb-10 text-lg md:text-xl; }

  .modern-content a {
    @apply text-orange-600 font-bold underline decoration-2 underline-offset-8 hover:bg-orange-600 hover:text-white px-1 py-0.5 transition-all rounded-md;
  }

  .modern-content blockquote {
    @apply border-none p-10 italic text-2xl font-black text-slate-900 dark:text-white my-16 bg-slate-50 dark:bg-white/5 rounded-[2.5rem] relative overflow-hidden shadow-inner;
  }

  .modern-content blockquote::before {
    content: '"';
    @apply absolute -top-4 -left-2 text-9xl text-orange-600 opacity-20 font-serif;
  }

  /* List Styling */
  .modern-content ul, .modern-content ol {
    @apply mb-10 pl-6;
  }
  .modern-content li {
    @apply mb-4 relative pl-2;
  }

  /* CSS untuk WordPress default classes */
  .wp-block-image { @apply my-12; }
  .wp-block-image figcaption { @apply text-center text-sm font-bold uppercase tracking-widest text-slate-400 mt-4; }
</style>