---
import Posts from "@/components/Posts.astro";
import Base from "@/layouts/Base.astro";
import { humanize } from "@/lib/utils/textConverter";
import { BiHash, BiChevronRight } from "react-icons/bi";

// PENTING: Matikan prerender agar build tidak memanggil API WordPress
export const prerender = false;

// Kita tidak butuh getStaticPaths jika prerender = false
const { tag } = Astro.params;
const title = humanize(tag || "");
---

<Base title={`Topik: #${title} | Amina Media`} description={`Kumpulan artikel #${title}.`}>
  <header class="bg-[#0b1c3c] py-16 text-white text-center">
    <h1 class="text-4xl font-black uppercase">Topik: #{title}</h1>
  </header>

  <main class="py-20 min-h-[50vh]">
    <div class="container">
      <div id="post-container" class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <p class="text-center col-span-full">Memuat artikel dari server...</p>
      </div>
    </div>
  </main>
</Base>

<script is:inline define:vars={{ tag }}>
  async function loadPosts() {
    const container = document.getElementById('post-container');
    const WP_URL = "https://studio.amina.or.id/graphql/";
    
    try {
      const res = await fetch(WP_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          query: `query GetPostsByTag($tagName: String!) { posts(where: {tag: $tagName}, first: 20) { nodes { title slug excerpt } } }`,
          variables: { tagName: tag }
        })
      });
      
      const json = await res.json();
      const posts = json.data?.posts?.nodes || [];
      
      if (posts.length > 0) {
        container.innerHTML = posts.map(p => `
          <div class="p-4 border rounded-lg">
            <h2 class="font-bold">${p.title}</h2>
            <p class="text-sm">${p.excerpt.replace(/<[^>]*>/g, '').substring(0, 100)}...</p>
          </div>
        `).join('');
      } else {
        container.innerHTML = '<p class="text-center col-span-full">Belum ada artikel.</p>';
      }
    } catch (e) {
      container.innerHTML = '<p class="text-center col-span-full">Gagal memuat artikel. Coba lagi nanti.</p>';
    }
  }
  loadPosts();
</script>